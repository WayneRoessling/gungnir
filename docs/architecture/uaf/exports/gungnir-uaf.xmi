          <ownedComment xmi:id="EAID_E4D74646_90F2_2393_F41B_6FE86930EF66" body="Owns configuration baselines, accounts and roles, the node, and the audit record."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_E00641BC_5F41_D8C9_9678_3B5C146B2966" name="Intelligence analyst" visibility="public">
          <ownedComment xmi:id="EAID_6FD93574_3255_B0E2_FDB5_E6A65DE0BAD1" body="Owns requirements and tasking, identification evidence and declarations, order of battle, pattern of life, dissemination."/>
