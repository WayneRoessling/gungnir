        <packagedElement xmi:type="uml:Class" xmi:id="EAID_587D5020_1938_7B36_EA67_C288F8F16657" name="TOGAF 10 ADM" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_503B111A_B934_0DC3_98A5_BC01592FE25B" name="Cursor-on-Target (CoT)" visibility="public"/>
      </packagedElement>
