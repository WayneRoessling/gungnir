        <packagedElement xmi:type="uml:Class" xmi:id="SD-01" name="Gungnir canonical schema v1" visibility="public">
          <ownedComment xmi:id="SD-01-desc" body="The versioned JSON form of every view and event; the journal and the API carry it."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SD-02" name="Apache Arrow (arrow 53)" visibility="public">
