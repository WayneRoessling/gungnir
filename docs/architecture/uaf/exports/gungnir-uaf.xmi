    <packagedElement xmi:type="uml:Package" xmi:id="PKG-Rs-Cn" name="Resource Connectivity Rs-Cn">
        <packagedElement xmi:type="uml:Class" xmi:id="RS-allocation" name="gungnir-allocation" visibility="public">
          <ownedComment xmi:id="RS-allocation-desc" body="Bellman/DP resource-to-track assignment."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-analytics" name="gungnir-analytics" visibility="public">
          <ownedComment xmi:id="RS-analytics-desc" body="Advanced 3D analytical functions -- line-of-sight, viewshed, sensor-coverage volumes, terrain masking, route deconfliction -- as standalone CPU services rendered by gungnir-viewport3d rather than embedded in it. docs/gungnir-capabilities.md §5.3 -- Medium."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-api" name="gungnir-api" visibility="public">
          <ownedComment xmi:id="RS-api-desc" body="Versioned, security-gated external contract (v1: snapshot, event stream, detection submit, plan decision) so remote desktops, peer C2 systems, analytics tools, or enterprise data services can integrate with a service node. Transport-neutral types here; the HTTP/JSON + WebSocket transport is the next stack addition. docs/gungnir-capabilities.md §5.5 -- High."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-app" name="gungnir-app" visibility="public">
          <ownedComment xmi:id="RS-app-desc" body="eframe desktop binary: bootstrap + AppState + update loop. The one crate allowed to depend on everything. Intentionally thin -- wiring, not logic, per rust-ui-architecture-coding-standards.md §1. Selects the embedded or remote services backend from gungnir-config (ARCHITECTURE.md §8) and runs eframe with Renderer::Glow so three-d has a GL context."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-assessment" name="gungnir-assessment" visibility="public">
          <ownedComment xmi:id="RS-assessment-desc" body="Threat/risk scoring, predicted time-to-impact, asset exposure, confidence-aware prioritization feeding the allocation decision's reward matrix. docs/gungnir-capabilities.md §5.4 -- Medium."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-association" name="gungnir-association" visibility="public">
          <ownedComment xmi:id="RS-association-desc" body="NN/GNN, Hungarian/JV, gating, JPDA, MHT."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-collab" name="gungnir-collab" visibility="public">
          <ownedComment xmi:id="RS-collab-desc" body="Collaboration &amp; multi-user concurrency: shared operational picture across desktops connected to one node, concurrent annotations, and authority conflict resolution between operators' decisions. docs/gungnir-capabilities.md §5.6 -- Medium. Server-authoritative mission state lives on the node (ARCHITECTURE.md §8)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-command" name="gungnir-command" visibility="public">
          <ownedComment xmi:id="RS-command-desc" body="Human-approval workflow sitting on top of gungnir-policy's verdicts -- the operator-facing accept/override/reject boundary for an intercept plan, with every decision recorded. docs/gungnir-capabilities.md §5.4 -- Critical. Human-owned changes. Pairs with gungnir-policy."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-config" name="gungnir-config" visibility="public">
          <ownedComment xmi:id="RS-config-desc" body="Managed, versioned, validated configuration for sensor definitions, filter/association selection, thresholds, allocation weights, backend selection (embedded or remote), and service-node settings. docs/gungnir-capabilities.md §5.1 -- High. Pairs with gungnir-mission."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-coord" name="gungnir-coord" visibility="public">
          <ownedComment xmi:id="RS-coord-desc" body="ECEF/ENU/NED/geodetic coordinate frame transforms."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-core" name="gungnir-core" visibility="public">
          <ownedComment xmi:id="RS-core-desc" body="CV/CA/CT motion models -- F/Q generation (exact-match closed-form oracle only) -- plus the identifier, lifecycle-status, and PSD-assertion primitives every higher crate shares (docs/agentic-coding-standards.md §1.2, §2.1)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-data-fusion" name="gungnir-data-fusion" visibility="public">
          <ownedComment xmi:id="RS-data-fusion-desc" body="GPU-accelerated point cloud registration/fusion (point-to-plane ICP) on wgpu compute, per rust-3d-data-ecosystem-build-vs-adopt.md §3. The one genuine ecosystem gap identified -- kept as its own crate, separate from gungnir-data, because it's the only data-layer crate that needs a wgpu::Device (borrowed from gungnir-render)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-data" name="gungnir-data" visibility="public">
          <ownedComment xmi:id="RS-data-desc" body="File I/O for point cloud / VTK scientific mesh / terrain / glTF, per rust-3d-data-ecosystem-build-vs-adopt.md §1. No egui/three-d/wgpu dependency -- unit-testable with plain cargo test."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-decision" name="gungnir-decision" visibility="public">
          <ownedComment xmi:id="RS-decision-desc" body="Course-of-action generation and comparison, constraint handling, what-if simulation against a live snapshot, and recommendation explanations -- beyond single-solution DP allocation. docs/gungnir-capabilities.md §5.4 -- Medium."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-eventing" name="gungnir-eventing" visibility="public">
          <ownedComment xmi:id="RS-eventing-desc" body="Transport-neutral broadcast event bus (in-process today; a durable/replayable log or network stream behind the same trait later). docs/gungnir-capabilities.md §5.1 -- High. Replaces the UI polling a mutable slice every frame."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-filters" name="gungnir-filters" visibility="public">
          <ownedComment xmi:id="RS-filters-desc" body="KF/EKF/UKF/PF/IMM/sqrt-UDU/RTS state estimation."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-fusion-async" name="gungnir-fusion-async" visibility="public">
          <ownedComment xmi:id="RS-fusion-async-desc" body="OOS handling / multi-rate async fusion pipeline. The only crate that uses the tokio runtime; the runtime is owned by the host binary."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-fuzz" name="gungnir-fuzz" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-geo" name="gungnir-geo" visibility="public">
          <ownedComment xmi:id="RS-geo-desc" body="Coordinate-reference-system governance, map/imagery layers, geocoding, vector features, spatial indexing, and geofencing. docs/gungnir-capabilities.md §5.3 -- Medium."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-identification" name="gungnir-identification" visibility="public">
          <ownedComment xmi:id="RS-identification-desc" body="Friend/foe/unknown track classification from an evidence-fusion process. gungnir-capabilities.md §5.3 -- Medium."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-identity" name="gungnir-identity" visibility="public">
          <ownedComment xmi:id="RS-identity-desc" body="Persistent global track/entity identity across feeds -- aliases, merge/split history, supersession -- beyond the tracking core's internal track IDs. docs/gungnir-capabilities.md §5.3 -- High."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-ingest" name="gungnir-ingest" visibility="public">
          <ownedComment xmi:id="RS-ingest-desc" body="Protocol-specific adapters plus a validation/authentication/quarantine gateway that normalizes live, recorded, and simulated sources into the canonical DetectionView before anything reaches the Tracking Service. docs/gungnir-capabilities.md §5.2 -- Critical. Gateway changes are human-owned."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-intercept-service" name="gungnir-intercept-service" visibility="public">
          <ownedComment xmi:id="RS-intercept-service-desc" body="App-facing facade over gungnir-allocation + gungnir-coord: turns current tracks + available resources into an intercept/tasking plan (gungnir-model PlanView). Kept separate from gungnir-tracking-service because it answers 'what should we do' rather than 'where are they' -- see ARCHITECTURE.md §2."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-interop" name="gungnir-interop" visibility="public">
          <ownedComment xmi:id="RS-interop-desc" body="Data standards &amp; interoperability: the schema catalog with version negotiation, the Arrow representation of detections, and the ASTERIX/STANAG codec boundary that gungnir-ingest adapters and gungnir-reporting exports use. docs/gungnir-capabilities.md §5.6 and §1 (interop schema row) -- Medium."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-metrics" name="gungnir-metrics" visibility="public">
          <ownedComment xmi:id="RS-metrics-desc" body="MOTA/MOTP, purity/fragmentation, track-to-truth assignment."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-mission" name="gungnir-mission" visibility="public">
          <ownedComment xmi:id="RS-mission-desc" body="Mission/session lifecycle: create/load/save/replay/close, plus scenario binding. gungnir-capabilities.md §5.1 -- High. Pairs with gungnir-config."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-ml" name="gungnir-ml" visibility="public">
          <ownedComment xmi:id="RS-ml-desc" body="The model and feature-extractor traits learned models are held to, a fake model for the consumers' tests, and the dataset extraction from test-track sets into the Arrow form docs/ml/data-pipeline.md documents (GAP-077, GAP-079). OnnxModel, the ort-backed real Model, is real compiling code behind the onnx-runtime feature (off by default: agentic-coding-standards.md §2.9, D-40) -- ort 2.0.0-rc.13's load-dynamic path panics rather than erroring when no compatible ONNX Runtime library is reachable, so it must not run inside default `cargo test`. ModelSet::load reports which named models are unavailable rather than pretending."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-model" name="gungnir-model" visibility="public">
          <ownedComment xmi:id="RS-model-desc" body="Canonical, versioned operational data model -- TrackView/DetectionView/ResourceView/PlanView and friends, with provenance, quality, identity, timestamps, and classification as first-class fields. Foundational/Critical per docs/gungnir-capabilities.md §5.1 -- the service facades and every productization crate build on this one."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-modelops" name="gungnir-modelops" visibility="public">
          <ownedComment xmi:id="RS-modelops-desc" body="Registry for selecting, tuning, comparing, validating, promoting, and rolling back filter/association configurations by mission profile, and (GAP-078) the model artefact -- name, version, hash, evaluation record -- a baseline optionally carries alongside its tracking configuration through the same promotion state machine. gungnir-capabilities.md §5.4 -- Medium."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-node" name="gungnir-node" visibility="public">
          <ownedComment xmi:id="RS-node-desc" body="Headless service-node binary for the on-prem and cloud profiles (ARCHITECTURE.md §8.1): hosts the services layer and the authoritative gungnir-store journal behind gungnir-api. Targets Linux x86_64 containers; depends on no UI, three-d, or wgpu crate."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-observability" name="gungnir-observability" visibility="public">
          <ownedComment xmi:id="RS-observability-desc" body="Production-facing metrics, structured logs, distributed traces, health checks, watchdogs, and alert correlation -- extends the developer-facing tracing instrumentation into an operator-facing system-status capability. gungnir-capabilities.md §5.5 -- High."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-oracle" name="gungnir-oracle" visibility="public">
          <ownedComment xmi:id="RS-oracle-desc" body="Differential-test harness against Python/MATLAB oracles. Depends on everything; nothing depends on it."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-policy" name="gungnir-policy" visibility="public">
          <ownedComment xmi:id="RS-policy-desc" body="Authority model, geofence/no-go enforcement, and policy evaluation sitting in front of the Intercept Planning Service's output. docs/gungnir-capabilities.md §5.4 -- Critical. Human-owned changes (agentic-workflow.md). Pairs with gungnir-command."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-remote" name="gungnir-remote" visibility="public">
          <ownedComment xmi:id="RS-remote-desc" body="Remote implementations of the TrackingService and InterceptService traits that talk to a gungnir-node over gungnir-api, so the desktop switches between the embedded and connected profiles without any UI change (ARCHITECTURE.md §8.2). Store-and-forward while disconnected."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-render" name="gungnir-render" visibility="public">
          <ownedComment xmi:id="RS-render-desc" body="Shared wgpu device/queue/surface management + egui&lt;-&gt;wgpu render pass wiring, per rust-ui-architecture-coding-standards.md §1. No tracking-domain knowledge."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-replay" name="gungnir-replay" visibility="public">
          <ownedComment xmi:id="RS-replay-desc" body="Deterministic session playback, timeline scrubbing, and recorded-data replay -- reads gungnir-store's event journal through a gungnir-time ReplayClockAuthority. docs/gungnir-capabilities.md §5.6 -- Lower."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-reporting" name="gungnir-reporting" visibility="public">
          <ownedComment xmi:id="RS-reporting-desc" body="Mission reports and export packages with provenance preserved: every figure traces back to the recorded event journal it was computed from. docs/gungnir-capabilities.md §5.6 -- Lower."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-resilience" name="gungnir-resilience" visibility="public">
          <ownedComment xmi:id="RS-resilience-desc" body="Resilience &amp; disconnected operations: store-and-forward of envelopes while a node is unreachable, checkpoints, and journal reconciliation after the link returns (ARCHITECTURE.md §8.4). docs/gungnir-capabilities.md §5.6 -- Medium."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-rfs" name="gungnir-rfs" visibility="public">
          <ownedComment xmi:id="RS-rfs-desc" body="PHD/CPHD, GLMB/LMB random finite set filters."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-scenario" name="gungnir-scenario" visibility="public">
          <ownedComment xmi:id="RS-scenario-desc" body="Ground-truth + sensor simulation, five-scenario generator. Test/bench dependency only -- never a normal dependency of a production crate."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-security" name="gungnir-security" visibility="public">
          <ownedComment xmi:id="RS-security-desc" body="Authentication, role/attribute-based authorization, encryption in transit and at rest, secrets/key management, signed binaries and configuration, audit logging. gungnir-capabilities.md §5.5 -- Critical."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-sensor-management" name="gungnir-sensor-management" visibility="public">
          <ownedComment xmi:id="RS-sensor-management-desc" body="Sensor registry (identity, modality, location, calibration version, operating state) plus tasking, mode management, and coverage planning. docs/gungnir-capabilities.md §5.2 -- High."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-store" name="gungnir-store" visibility="public">
          <ownedComment xmi:id="RS-store-desc" body="Durable storage for mission sessions (an append-only JSON-lines event journal), replay artifacts, configuration baselines, and audit logs, with an explicit retention/deletion policy. docs/gungnir-capabilities.md §5.1 -- High."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-testkit" name="gungnir-testkit" visibility="public">
          <ownedComment xmi:id="RS-testkit-desc" body="Shared proptest strategies for the tracking core. Depends on no workspace crate (so it can be a dev-dependency of every one of them without a dev-dependency cycle); nothing depends on it at runtime."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-time" name="gungnir-time" visibility="public">
          <ownedComment xmi:id="RS-time-desc" body="Clock discipline across sensors: source-time vs. receipt-time semantics, late-data policy, deterministic replay-time control, synchronization health. docs/gungnir-capabilities.md §5.2 -- Critical."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-track-fusion" name="gungnir-track-fusion" visibility="public">
          <ownedComment xmi:id="RS-track-fusion-desc" body="Track-to-track fusion (CI/info-matrix), sensor registration/bias."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-track" name="gungnir-track" visibility="public">
          <ownedComment xmi:id="RS-track-desc" body="Track lifecycle: init/confirm/coast/delete."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-tracking-service" name="gungnir-tracking-service" visibility="public">
          <ownedComment xmi:id="RS-tracking-service-desc" body="App-facing facade over the tracking/estimation core. Owns the IMM bank, associator, track manager, and async multi-rate/OOS fusion pipeline behind one trait, and projects the core's kinematic Track into the canonical gungnir-model TrackView. See ARCHITECTURE.md §2."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-ui" name="gungnir-ui" visibility="public">
          <ownedComment xmi:id="RS-ui-desc" body="2D egui dashboard panels + centralized theme, per rust-ui-architecture-coding-standards.md §1/§6. One file per panel; no magic layout numbers. Reads gungnir-model views only; holds no state of its own."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-viewport3d" name="gungnir-viewport3d" visibility="public">
          <ownedComment xmi:id="RS-viewport3d-desc" body="three-d scene setup, camera, streaming/scientific data bridges, and live track/intercept rendering, drawn into eframe's OpenGL (glow) context. Combines rust-3d-data-ecosystem-build-vs-adopt.md §2 with gungnir-model views -- see ARCHITECTURE.md §4-5 for why track rendering lives here rather than in a translation crate."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="RS-workflow" name="gungnir-workflow" visibility="public">
          <ownedComment xmi:id="RS-workflow-desc" body="Human factors &amp; operator workflow: role-based workspace layouts, the alert acknowledgement/escalation lifecycle, annotations and cases -- turning a set of panels into a designed operator workflow. docs/gungnir-capabilities.md §5.6 -- Medium."/>
        </packagedElement>
