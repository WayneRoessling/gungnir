    <packagedElement xmi:type="uml:Package" xmi:id="PKG-Ar-Cn" name="Actual Resources Connectivity Ar-Cn">
        <packagedElement xmi:type="uml:InstanceSpecification" xmi:id="AR-01" name="Operator workstation host" visibility="public">
          <ownedComment xmi:id="AR-01-desc" body="Windows 11 with a discrete NVIDIA GPU running gungnir-app; OpenGL context for egui and three-d; wgpu compute device for point-cloud fusion."/>
        </packagedElement>
        <packagedElement xmi:type="uml:InstanceSpecification" xmi:id="AR-02" name="On-prem service node host" visibility="public">
          <ownedComment xmi:id="AR-02-desc" body="Linux x86_64 container running gungnir-node on the site or sector LAN; authoritative journal on local storage."/>
        </packagedElement>
        <packagedElement xmi:type="uml:InstanceSpecification" xmi:id="AR-03" name="Cloud service node host" visibility="public">
          <ownedComment xmi:id="AR-03-desc" body="The same container hosted in the cloud; WAN clients; encryption at rest with keys off-host (GAP-060)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:InstanceSpecification" xmi:id="AR-04" name="Sensor feeds" visibility="public">
          <ownedComment xmi:id="AR-04-desc" body="Radar, EO/IR, acoustic, RF, ISR video, cooperative receivers, spotter applications feeding the node or a desktop through adapters."/>
        </packagedElement>
        <packagedElement xmi:type="uml:InstanceSpecification" xmi:id="AR-05" name="Peer command-and-control nodes" visibility="public">
          <ownedComment xmi:id="AR-05-desc" body="Neighbouring sectors, higher command, and coalition systems reached through the API and interop formats."/>
        </packagedElement>
        <packagedElement xmi:type="uml:InstanceSpecification" xmi:id="AR-06" name="Effector systems" visibility="public">
          <ownedComment xmi:id="AR-06-desc" body="Fire units and effector controllers that receive handoff messages and report outcomes."/>
        </packagedElement>
        <packagedElement xmi:type="uml:InstanceSpecification" xmi:id="AR-07" name="Build and release infrastructure" visibility="public">
          <ownedComment xmi:id="AR-07-desc" body="Self-hosted GitLab with runners (including a GPU runner) and the container registry (D-10)."/>
        </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="PKG-Rq" name="Requirements">
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-01" name="Observations from heterogeneous sensors are ingested through one governed gateway that validates and quarantines" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-02" name="Every source is authenticated before its data enters the picture" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-03" name="Sensor modes, tasking, and calibration are held in a registry and changeable by the sensor manager" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-04" name="Coverage is computed and coverage gaps are detected and displayed" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-05" name="Data from sources with different clocks is time-disciplined and skew is detected" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-06" name="Cooperative identity from open protocols is decoded and fused as evidence" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-07" name="A multi-sensor, multi-rate, out-of-sequence tracking pipeline maintains the picture" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-08" name="Tracks carry a quality and a staleness that the interface renders differently from fresh data" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-09" name="Classification and identification produce evidence with a margin rule and per-class thresholds set by policy" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-10" name="Entities keep a global identity with lineage across sources and sessions" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-11" name="Threats are scored against a defended-asset list with per-class lethality and asset weighting" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-12" name="The system recommends a cheapest-adequate assignment of resources to tracks within readiness, geometry, and policy" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-13" name="Every recommendation carries a rationale and its alternatives" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-14" name="The queue orders pending decisions by priority and time remaining, and supports pre-delegation where policy allows" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-15" name="A session is journaled, replayable, and reproduces the same picture" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-16" name="Measures are computed from the journal without manual collation" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-D-01" name="Shared types have exactly one owning crate; everything above re-exports" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-D-02" name="Every detection carries its source and its receipt time" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-D-03" name="Identification evidence names its producer, including model name and version for a machine-learning source" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-D-04" name="Envelopes carry a bus sequence number and a mission time" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-D-05" name="The node journal fsyncs every envelope; desktop journals fsync on session save and every five seconds" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-D-06" name="Journals merge in mission-time order, duplicates are dropped, and conflicting decisions are reported rather than resolved" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-D-07" name="Views, reports, and the interface contract carry a releasability marking" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-D-08" name="Training data and model artefacts live outside this repository; only the manifest enters it" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-I-01" name="The node exposes a versioned contract for snapshot, event stream, detection submission, and plan decisions" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-I-02" name="Schema versions are negotiated explicitly and an incompatible peer is refused, not silently accepted" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-I-03" name="Radar feeds decode from ASTERIX category 048" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-I-04" name="Coalition track exchange uses STANAG 4676" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-I-05" name="Each external party is a configurable endpoint with a message type rather than a bespoke integration" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-I-06" name="Detections are exportable in a columnar format for analytics and bulk exchange" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-S-01" name="No engagement, effector command, or reserved identity declaration executes without a recorded human decision" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-S-02" name="Authority is enforced per role, per class, and per engagement layer, per the authority matrix" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-S-03" name="Weapons control status is set by the authorized roles and constrains every recommendation" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-S-04" name="Pending decisions escalate and time out rather than waiting indefinitely" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-S-05" name="Every consequential act is attributable to a person, a role, and a mission time in an audit log" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-S-06" name="Machine identities authenticate with mutual transport-layer security; operator sessions use short-lived signed tokens" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-S-07" name="Data is encrypted in transit on every network crossing and at rest where the deployment requires it" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-S-08" name="The assistant has no tool that changes state and no dependency path to a crate that does" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-S-09" name="Untrusted text from sensors, peers, annotations, and reports is treated as data by the assistant, never as instruction" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-S-10" name="Every release carries a bill of materials, a signature, and its assurance reports" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-P-01" name="The desktop sustains its frame-rate budget with the 3D viewport open under a dense-swarm scenario" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-P-02" name="The per-frame tick stays inside its budget with ingest, poll, plan, and journal all running" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-P-03" name="Snapshot calls do not touch the pipeline and stay inside their budget" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-P-04" name="Detection to on-screen update stays inside its end-to-end budget in the embedded profile" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-P-05" name="The node sustains its detection ingest throughput through validation and quarantine" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-P-06" name="Detection to event-stream publish stays inside its budget on-prem and in cloud" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-P-07" name="An accepted envelope is durable within its budget, and the node recovers to serving within its budget after restart" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-P-08" name="A desktop falls back to embedded operation within its budget after link loss, stores and forwards to capacity, and reconciles within its budget" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-P-09" name="Covariances stay positive semi-definite and no value becomes non-finite over long runs" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-U-01" name="Each role has a workspace containing what that role's threads need and not more" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-U-02" name="Every layout carries a status strip stating what the system knows and does not know" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-U-03" name="Absence, staleness, and degradation are visible rather than inferred from silence" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-U-04" name="Machine assistance is labelled, sourced, and carries no authority in the interface" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-U-05" name="Default display vocabulary is the agreed standard terms, with a per-deployment override table" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-C-01" name="No dependency edge exists that `ARCHITECTURE.md` does not draw" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-C-02" name="Every dependency is recorded in the standards document §2.9 and pinned once" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-C-03" name="No `unwrap()` or `expect()` outside tests, entry points, and debug-only invariant checks" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-C-04" name="Unimplemented capability returns a named error on every reachable path" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-C-05" name="The graphics and compute contexts stay separate and separately pinned" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-C-06" name="Deployment profiles differ by configuration and wiring, never by conditional logic in a domain crate" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-C-07" name="The two binaries contain wiring, not domain logic" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-C-08" name="No pass criterion or measure target is widened to make a test pass" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-C-09" name="Every artefact is unclassified and derived from public sources" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="REQ-C-10" name="No verification gate is waived by an agent" visibility="public">
        </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="PKG-Sv-Tr" name="Service Traceability Sv-Tr">
        <packagedElement xmi:type="uml:Abstraction" xmi:id="REL-266" name="realizes: SV-08 -&gt; OA-01" visibility="public" supplier="OA-01" client="SV-08"/>
