          <ownedComment xmi:id="EAID_7776AB11_5B06_5848_A19D_322B8C3DC786" body="Runs the sector; manages the recommendation queue, weapons control status, holds, degraded-state acknowledgement, reconciliation conflicts, plan apply."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_F25DD488_F9B1_86B2_6C51_64ECC15F6119" name="Analyst" visibility="public">
          <ownedComment xmi:id="EAID_1443C25A_69E3_484C_C19B_AD92E2FE5F94" body="Works the recorded record; replay, after-action review, reports, measures, model promotion evidence."/>
