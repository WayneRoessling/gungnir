      <packagedElement xmi:type="uml:Package" xmi:id="EAPK_34896D57_5A99_007A_944A_6BA06B9C3D7F" name="Actual Resources Connectivity Ar-Cn" visibility="public">
        <packagedElement xmi:type="uml:InstanceSpecification" xmi:id="EAID_34F2213B_561F_EEE0_EAA8_7ECC0FC87DD3" name="Operator workstation host" visibility="public"/>
        <packagedElement xmi:type="uml:InstanceSpecification" xmi:id="EAID_57CA4D1A_98B5_FC6C_C438_6606BC1EBDBF" name="On-prem service node host" visibility="public"/>
        <packagedElement xmi:type="uml:InstanceSpecification" xmi:id="EAID_FF1D541B_C393_2D83_7CBD_735C4D0223CD" name="Cloud service node host" visibility="public"/>
        <packagedElement xmi:type="uml:InstanceSpecification" xmi:id="EAID_C1498CFA_F6BD_F63B_0601_825CE4A9AA25" name="Sensor feeds" visibility="public"/>
        <packagedElement xmi:type="uml:InstanceSpecification" xmi:id="EAID_F255CD5C_865C_FE4F_28AF_6DB1797DD884" name="Peer command-and-control nodes" visibility="public"/>
        <packagedElement xmi:type="uml:InstanceSpecification" xmi:id="EAID_F4198540_395C_7234_4D4E_653E4F6B8E06" name="Effector systems" visibility="public"/>
        <packagedElement xmi:type="uml:InstanceSpecification" xmi:id="EAID_F2F535E7_5731_D8E1_5255_157D735984F7" name="Build and release infrastructure" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Package" xmi:id="EAPK_0598B85C_2AC8_5479_6D33_130959E6B742" name="Requirements" visibility="public">
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_754A39B4_FC16_3ADB_3952_CDC3FFF0CA3E" name="Observations from heterogeneous sensors are ingested through one governed gateway that validates and quarantines" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_EBDE3D81_A0C8_B16D_EC69_4FA415AB4E47" name="Every source is authenticated before its data enters the picture" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_80F9610D_B2F6_5B09_6A5A_A93B7F1E095C" name="Sensor modes, tasking, and calibration are held in a registry and changeable by the sensor manager" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_1E73AFC4_4B2B_F3E2_D376_3982D715AFD8" name="Coverage is computed and coverage gaps are detected and displayed" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_837A461C_EC33_A543_1490_61DBFD4B31A7" name="Data from sources with different clocks is time-disciplined and skew is detected" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_997F11C9_5890_20E5_C1D6_73FDC03350D8" name="Cooperative identity from open protocols is decoded and fused as evidence" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_CCCA7BE3_968C_577E_D85F_CA872DB45232" name="A multi-sensor, multi-rate, out-of-sequence tracking pipeline maintains the picture" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_94DA5F09_C765_D69E_327F_9C5EC45FD34D" name="Tracks carry a quality and a staleness that the interface renders differently from fresh data" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_83AF5CD4_5122_CB59_143C_253B51573034" name="Classification and identification produce evidence with a margin rule and per-class thresholds set by policy" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_E4F45DFF_A346_6873_3810_0B8E94056903" name="Entities keep a global identity with lineage across sources and sessions" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_E7E5D897_3431_65D6_8829_0028E670D972" name="Threats are scored against a defended-asset list with per-class lethality and asset weighting" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_4047B9AA_706B_792A_7554_5654C0DB54AD" name="The system recommends a cheapest-adequate assignment of resources to tracks within readiness, geometry, and policy" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_92AF3D03_50D3_2580_CF16_D978BB7FABE8" name="Every recommendation carries a rationale and its alternatives" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_0DFC3E72_A06A_4FBF_B086_20FDF2C125C2" name="The queue orders pending decisions by priority and time remaining, and supports pre-delegation where policy allows" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_D4E46CF1_62C2_70A9_008D_EBAE8CA59AB1" name="A session is journaled, replayable, and reproduces the same picture" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_3B65DC64_B2A1_976A_A837_36CD7C0888BB" name="Measures are computed from the journal without manual collation" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_F76DF953_D53C_DCC6_4C1A_0BD98315CFE7" name="Shared types have exactly one owning crate; everything above re-exports" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_1BCD2617_2558_5ADA_1C95_8EB659D0B3AC" name="Every detection carries its source and its receipt time" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_35852511_F61D_A317_433A_BDC100543F87" name="Identification evidence names its producer, including model name and version for a machine-learning source" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_92178A91_BA84_4246_496A_69701070B8F5" name="Envelopes carry a bus sequence number and a mission time" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_8C5CA54F_235A_17FE_6DF9_4E97F9B9750E" name="The node journal fsyncs every envelope; desktop journals fsync on session save and every five seconds" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_D136AE0D_ECAA_B67F_E757_FAE55321244C" name="Journals merge in mission-time order, duplicates are dropped, and conflicting decisions are reported rather than resolved" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_9A13BFC2_8B25_DC8E_4BD6_2F15FFA1F106" name="Views, reports, and the interface contract carry a releasability marking" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_3B0A0128_B1A9_1BA9_7012_82246760BBFE" name="Training data and model artefacts live outside this repository; only the manifest enters it" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_13747F8E_2AE9_C284_49BB_B67F6550A665" name="The node exposes a versioned contract for snapshot, event stream, detection submission, and plan decisions" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_489BEE20_483D_3204_7D8B_C110C30FF220" name="Schema versions are negotiated explicitly and an incompatible peer is refused, not silently accepted" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_C7E98DD5_7852_9E70_7246_8FD9D1263781" name="Radar feeds decode from ASTERIX category 048" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_406148DA_E154_7739_D279_8D506295282A" name="Coalition track exchange uses STANAG 4676" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_0C777A2B_C0DE_AB1C_4826_1F29F4B3C31A" name="Each external party is a configurable endpoint with a message type rather than a bespoke integration" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_80985EB0_812E_20E0_9789_13022A644EA2" name="Detections are exportable in a columnar format for analytics and bulk exchange" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_D49DE76C_B653_2EED_9503_20478C9E6A0B" name="No engagement, effector command, or reserved identity declaration executes without a recorded human decision" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_0736A4E2_000D_22FF_7C86_7BA1106B76CF" name="Authority is enforced per role, per class, and per engagement layer, per the authority matrix" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_E2946A7C_DA7F_35BD_0637_CA05716B3E25" name="Weapons control status is set by the authorized roles and constrains every recommendation" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_D8DEF058_94A6_4713_97A1_0975D2923E03" name="Pending decisions escalate and time out rather than waiting indefinitely" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_3B009CFE_5F5E_BE9C_3FBA_F8247BC5D95D" name="Every consequential act is attributable to a person, a role, and a mission time in an audit log" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_220EACC6_9864_4DCC_AEEA_B18EEDF2C059" name="Machine identities authenticate with mutual transport-layer security; operator sessions use short-lived signed tokens" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_7FD80E54_0996_2FC4_0DBA_D8ED126ECA35" name="Data is encrypted in transit on every network crossing and at rest where the deployment requires it" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_5EC38E56_A9FB_7043_7E6A_B521E1646646" name="The assistant has no tool that changes state and no dependency path to a crate that does" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_636E41EF_011A_2087_065D_FC39C6CC544D" name="Untrusted text from sensors, peers, annotations, and reports is treated as data by the assistant, never as instruction" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_7F1EA461_FEC5_968B_A43D_D8862C06EEC5" name="Every release carries a bill of materials, a signature, and its assurance reports" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_1747C6EC_FC72_0105_046D_6A05E1F20195" name="The desktop sustains its frame-rate budget with the 3D viewport open under a dense-swarm scenario" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_6006039F_A90C_64CB_E094_4F0058DDD247" name="The per-frame tick stays inside its budget with ingest, poll, plan, and journal all running" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_D8BCFE4E_CB4A_600A_BE76_948ED4B628D1" name="Snapshot calls do not touch the pipeline and stay inside their budget" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_6229A68A_C397_6DB2_FA70_A006957DDD7F" name="Detection to on-screen update stays inside its end-to-end budget in the embedded profile" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_E0D01803_25A7_4112_E438_937D53C3673C" name="The node sustains its detection ingest throughput through validation and quarantine" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_5707817D_88E4_E906_47C6_824D052A6031" name="Detection to event-stream publish stays inside its budget on-prem and in cloud" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_AE351544_B7F4_067F_6C11_5CC4BF37A5E6" name="An accepted envelope is durable within its budget, and the node recovers to serving within its budget after restart" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_947842AC_3EC8_D8A4_0FA0_2B8F9768654A" name="A desktop falls back to embedded operation within its budget after link loss, stores and forwards to capacity, and reconciles within its budget" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_02470145_CD18_24DF_F261_C0BE51A30A06" name="Covariances stay positive semi-definite and no value becomes non-finite over long runs" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_D37F1158_1F25_90E2_E587_DCDE97880BD3" name="Each role has a workspace containing what that role's threads need and not more" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_88796AF2_645F_A440_3ED9_E9A6E788E3BB" name="Every layout carries a status strip stating what the system knows and does not know" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_A07C6DDB_27FC_F6B6_5DE9_CD4F61390254" name="Absence, staleness, and degradation are visible rather than inferred from silence" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_DD90FEEB_A560_8430_07BB_A36BF02FEF45" name="Machine assistance is labelled, sourced, and carries no authority in the interface" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_43CD6935_E382_3F76_2F13_C6E2CA785239" name="Default display vocabulary is the agreed standard terms, with a per-deployment override table" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_7E2FB2F1_48B3_F986_D77E_5E7BA93088E2" name="No dependency edge exists that `ARCHITECTURE.md` does not draw" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_901D5CF2_DB01_167E_E55E_81D4902891D8" name="Every dependency is recorded in the standards document §2.9 and pinned once" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_7967AF56_988C_98DC_3DE3_18A89053EE49" name="No `unwrap()` or `expect()` outside tests, entry points, and debug-only invariant checks" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_F118E997_66BF_3348_8DA3_857C0D90E8CF" name="Unimplemented capability returns a named error on every reachable path" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_A1313DAF_007E_ADE9_1E86_B66791E3BB4C" name="The graphics and compute contexts stay separate and separately pinned" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_721CECFE_BF9B_CA91_E19D_1EED351334AD" name="Deployment profiles differ by configuration and wiring, never by conditional logic in a domain crate" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_B52CD98C_4C72_DCBA_8D47_1EF441B7D4A7" name="The two binaries contain wiring, not domain logic" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_10CB20BE_AEC0_5967_3B0C_B6612C2B88AB" name="No pass criterion or measure target is widened to make a test pass" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_7A3DB3B9_174A_A896_473D_0DC30B405B40" name="Every artefact is unclassified and derived from public sources" visibility="public"/>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_4773AE09_3D8B_2921_2B5C_B5724552C898" name="No verification gate is waived by an agent" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Package" xmi:id="EAPK_1C204B50_814F_AC35_6797_58F42A684745" name="Service Traceability Sv-Tr" visibility="public">
