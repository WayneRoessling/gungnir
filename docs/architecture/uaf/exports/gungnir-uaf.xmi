    <packagedElement xmi:type="uml:Package" xmi:id="PKG-information_elements" name="Information Elements">
      <packagedElement xmi:type="uml:Class" xmi:id="IE-01" name="DetectionView">
        <ownedComment xmi:id="IE-01-desc" body="The canonical observation after validation; sensor, source time, receipt time, ENU measurement, provenance."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-02" name="TrackView">
        <ownedComment xmi:id="IE-02-desc" body="The canonical track; state, covariance, classification, provenance, quality, mission time."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-03" name="ResourceView">
        <ownedComment xmi:id="IE-03-desc" body="A taskable resource; position, capacity, readiness."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-04" name="PlanView">
        <ownedComment xmi:id="IE-04-desc" body="The intercept service's recommendation; solutions and policy value."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-05" name="InterceptSolutionView">
        <ownedComment xmi:id="IE-05-desc" body="One resource-to-track pairing with intercept point and time (None until the solver exists)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-06" name="SystemHealth">
        <ownedComment xmi:id="IE-06-desc" body="Tracking, intercept, and ingest health flags as reported, never inferred."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-07" name="Provenance">
        <ownedComment xmi:id="IE-07-desc" body="Source sensors, calibration baseline, algorithm version."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-08" name="Quality">
        <ownedComment xmi:id="IE-08-desc" body="Association confidence, latency, staleness."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-09" name="Classification">
        <ownedComment xmi:id="IE-09-desc" body="Unknown, Neutral, Friendly, Hostile."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-10" name="MissionTime">
        <ownedComment xmi:id="IE-10-desc" body="Seconds on the mission clock."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-11" name="GlobalEntityId">
        <ownedComment xmi:id="IE-11-desc" body="Persistent identity across sessions (u128; uuid v7 under GAP-069)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-12" name="Envelope">
        <ownedComment xmi:id="IE-12-desc" body="Sequence number, mission time, and one Event; the unit the bus carries and the journal stores."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-13" name="TrackingEvent">
        <ownedComment xmi:id="IE-13-desc" body="TrackInitiated, TrackUpdated, TrackCoasting, TrackDeleted."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-14" name="InterceptEvent">
        <ownedComment xmi:id="IE-14-desc" body="PlanProposed, PlanApproved, PlanSuperseded."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-15" name="IngestEvent">
        <ownedComment xmi:id="IE-15-desc" body="Accepted or Quarantined with reason."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-16" name="CommandEvent">
        <ownedComment xmi:id="IE-16-desc" body="ApprovalRequested; Decided with plan, accepted, operator."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-17" name="ConfigBaseline">
        <ownedComment xmi:id="IE-17-desc" body="Versioned, validated configuration; sensors, resources, tracking, backend, node, horizon, data directory."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-18" name="DecisionRecord">
        <ownedComment xmi:id="IE-18-desc" body="Who decided what on which plan, with verdict and time."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-19" name="PolicyVerdict">
        <ownedComment xmi:id="IE-19-desc" body="Approved (never by built-in engines), Denied with reason, RequiresHumanApproval."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-20" name="AuditEntry">
        <ownedComment xmi:id="IE-20-desc" body="Actor, action, time, outcome; append-only."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-21" name="Alert and AlertLifecycle">
        <ownedComment xmi:id="IE-21-desc" body="Alert with severity; New, Acknowledged, Escalated, Closed with history."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-22" name="SnapshotResponse">
        <ownedComment xmi:id="IE-22-desc" body="Schema version, tracks, plan, health."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-23" name="ApprovalRequest">
        <ownedComment xmi:id="IE-23-desc" body="Plan id, accepted, operator."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-24" name="SubmitDetectionRequest">
        <ownedComment xmi:id="IE-24-desc" body="One DetectionView for the gateway."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-25" name="SubscribeRequest">
        <ownedComment xmi:id="IE-25-desc" body="The first frame of the event stream; from_seq."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-26" name="SchemaEntry">
        <ownedComment xmi:id="IE-26-desc" body="Name, version, kind of a schema the build speaks."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-27" name="SensorRecord and CoverageRegion">
        <ownedComment xmi:id="IE-27-desc" body="Identity, modality, location, calibration version, mode; coverage geometry."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-28" name="Report">
        <ownedComment xmi:id="IE-28-desc" body="A mission report or export with figures traceable to the journal."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-29" name="IdentificationEvidence">
        <ownedComment xmi:id="IE-29-desc" body="One piece of evidence with source and weight toward a classification."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-30" name="RiskScore">
        <ownedComment xmi:id="IE-30-desc" body="Threat score per track with contributing factors."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-31" name="ReconciliationReport">
        <ownedComment xmi:id="IE-31-desc" body="Merged journal statistics and the conflicting decisions found."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-32" name="WorkspaceLayout">
        <ownedComment xmi:id="IE-32-desc" body="The panels a role sees, in order."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="IE-33" name="Mission and SessionId">
        <ownedComment xmi:id="IE-33-desc" body="A session with its state and configuration."/>
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="PKG-actual_resources" name="Actual Resources">
      <packagedElement xmi:type="uml:Class" xmi:id="AR-01" name="Operator workstation host">
        <ownedComment xmi:id="AR-01-desc" body="Windows 11 with a discrete NVIDIA GPU running gungnir-app; OpenGL context for egui and three-d; wgpu compute device for point-cloud fusion."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="AR-02" name="On-prem service node host">
        <ownedComment xmi:id="AR-02-desc" body="Linux x86_64 container running gungnir-node on the site or sector LAN; authoritative journal on local storage."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="AR-03" name="Cloud service node host">
        <ownedComment xmi:id="AR-03-desc" body="The same container hosted in the cloud; WAN clients; encryption at rest with keys off-host (GAP-060)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="AR-04" name="Sensor feeds">
        <ownedComment xmi:id="AR-04-desc" body="Radar, EO/IR, acoustic, RF, ISR video, cooperative receivers, spotter applications feeding the node or a desktop through adapters."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="AR-05" name="Peer command-and-control nodes">
        <ownedComment xmi:id="AR-05-desc" body="Neighbouring sectors, higher command, and coalition systems reached through the API and interop formats."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="AR-06" name="Effector systems">
        <ownedComment xmi:id="AR-06-desc" body="Fire units and effector controllers that receive handoff messages and report outcomes."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="AR-07" name="Build and release infrastructure">
        <ownedComment xmi:id="AR-07-desc" body="Self-hosted GitLab with runners (including a GPU runner) and the container registry (D-10)."/>
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="PKG-requirements" name="Requirements">
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-01" name="Observations from heterogeneous sensors are ingested through one governed gateway that validates and quarantines">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-02" name="Every source is authenticated before its data enters the picture">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-03" name="Sensor modes, tasking, and calibration are held in a registry and changeable by the sensor manager">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-04" name="Coverage is computed and coverage gaps are detected and displayed">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-05" name="Data from sources with different clocks is time-disciplined and skew is detected">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-06" name="Cooperative identity from open protocols is decoded and fused as evidence">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-07" name="A multi-sensor, multi-rate, out-of-sequence tracking pipeline maintains the picture">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-08" name="Tracks carry a quality and a staleness that the interface renders differently from fresh data">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-09" name="Classification and identification produce evidence with a margin rule and per-class thresholds set by policy">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-10" name="Entities keep a global identity with lineage across sources and sessions">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-11" name="Threats are scored against a defended-asset list with per-class lethality and asset weighting">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-12" name="The system recommends a cheapest-adequate assignment of resources to tracks within readiness, geometry, and policy">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-13" name="Every recommendation carries a rationale and its alternatives">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-14" name="The queue orders pending decisions by priority and time remaining, and supports pre-delegation where policy allows">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-15" name="A session is journaled, replayable, and reproduces the same picture">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-F-16" name="Measures are computed from the journal without manual collation">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-D-01" name="Shared types have exactly one owning crate; everything above re-exports">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-D-02" name="Every detection carries its source and its receipt time">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-D-03" name="Identification evidence names its producer, including model name and version for a machine-learning source">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-D-04" name="Envelopes carry a bus sequence number and a mission time">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-D-05" name="The node journal fsyncs every envelope; desktop journals fsync on session save and every five seconds">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-D-06" name="Journals merge in mission-time order, duplicates are dropped, and conflicting decisions are reported rather than resolved">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-D-07" name="Views, reports, and the interface contract carry a releasability marking">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-D-08" name="Training data and model artefacts live outside this repository; only the manifest enters it">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-I-01" name="The node exposes a versioned contract for snapshot, event stream, detection submission, and plan decisions">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-I-02" name="Schema versions are negotiated explicitly and an incompatible peer is refused, not silently accepted">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-I-03" name="Radar feeds decode from ASTERIX category 048">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-I-04" name="Coalition track exchange uses STANAG 4676">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-I-05" name="Each external party is a configurable endpoint with a message type rather than a bespoke integration">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-I-06" name="Detections are exportable in a columnar format for analytics and bulk exchange">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-S-01" name="No engagement, effector command, or reserved identity declaration executes without a recorded human decision">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-S-02" name="Authority is enforced per role, per class, and per engagement layer, per the authority matrix">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-S-03" name="Weapons control status is set by the authorized roles and constrains every recommendation">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-S-04" name="Pending decisions escalate and time out rather than waiting indefinitely">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-S-05" name="Every consequential act is attributable to a person, a role, and a mission time in an audit log">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-S-06" name="Machine identities authenticate with mutual transport-layer security; operator sessions use short-lived signed tokens">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-S-07" name="Data is encrypted in transit on every network crossing and at rest where the deployment requires it">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-S-08" name="The assistant has no tool that changes state and no dependency path to a crate that does">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-S-09" name="Untrusted text from sensors, peers, annotations, and reports is treated as data by the assistant, never as instruction">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-S-10" name="Every release carries a bill of materials, a signature, and its assurance reports">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-P-01" name="The desktop sustains its frame-rate budget with the 3D viewport open under a dense-swarm scenario">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-P-02" name="The per-frame tick stays inside its budget with ingest, poll, plan, and journal all running">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-P-03" name="Snapshot calls do not touch the pipeline and stay inside their budget">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-P-04" name="Detection to on-screen update stays inside its end-to-end budget in the embedded profile">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-P-05" name="The node sustains its detection ingest throughput through validation and quarantine">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-P-06" name="Detection to event-stream publish stays inside its budget on-prem and in cloud">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-P-07" name="An accepted envelope is durable within its budget, and the node recovers to serving within its budget after restart">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-P-08" name="A desktop falls back to embedded operation within its budget after link loss, stores and forwards to capacity, and reconciles within its budget">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-P-09" name="Covariances stay positive semi-definite and no value becomes non-finite over long runs">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-U-01" name="Each role has a workspace containing what that role's threads need and not more">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-U-02" name="Every layout carries a status strip stating what the system knows and does not know">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-U-03" name="Absence, staleness, and degradation are visible rather than inferred from silence">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-U-04" name="Machine assistance is labelled, sourced, and carries no authority in the interface">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-U-05" name="Default display vocabulary is the agreed standard terms, with a per-deployment override table">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-C-01" name="No dependency edge exists that `ARCHITECTURE.md` does not draw">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-C-02" name="Every dependency is recorded in the standards document §2.9 and pinned once">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-C-03" name="No `unwrap()` or `expect()` outside tests, entry points, and debug-only invariant checks">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-C-04" name="Unimplemented capability returns a named error on every reachable path">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-C-05" name="The graphics and compute contexts stay separate and separately pinned">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-C-06" name="Deployment profiles differ by configuration and wiring, never by conditional logic in a domain crate">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-C-07" name="The two binaries contain wiring, not domain logic">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-C-08" name="No pass criterion or measure target is widened to make a test pass">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-C-09" name="Every artefact is unclassified and derived from public sources">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="REQ-C-10" name="No verification gate is waived by an agent">
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="PKG-relationships" name="Relationships">
