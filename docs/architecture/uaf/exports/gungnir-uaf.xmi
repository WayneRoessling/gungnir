          <ownedComment xmi:id="SV-18-desc" body="Rationale (real); alternatives and what-if (trait surface)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-19" name="Model registry" visibility="public">
          <ownedComment xmi:id="SV-19-desc" body="Validate, promote, roll back algorithm baselines."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-20" name="Authentication" visibility="public">
          <ownedComment xmi:id="SV-20-desc" body="Credential to OperatorId (trait only; mechanism D-02)."/>
