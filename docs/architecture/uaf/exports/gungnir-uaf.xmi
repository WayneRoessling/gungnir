<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmlns:uml="http://schema.omg.org/spec/UML/2.1">
  <uml:Model xmi:type="uml:Model" xmi:id="MODEL-gungnir-uaf" name="Gungnir UAF Model">
    <packagedElement xmi:type="uml:Package" xmi:id="PKG-capabilities" name="Capabilities">
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-1" name="Sense">
        <ownedComment xmi:id="CAP-1-desc" body="Bring every observation the sector can obtain into one governed, time-disciplined stream."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-1.1" name="Ingest observations from every sensor class">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-1.2" name="Validate, authenticate, and quarantine input">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-1.3" name="Manage sensor readiness, modes, tasking, and calibration">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-1.4" name="Know sensor coverage and gaps over terrain">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-1.5" name="Keep time discipline">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-1.6" name="Receive early warning, tracks, and reports from peers">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-1.7" name="Receive cooperative identity">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-2" name="Understand">
        <ownedComment xmi:id="CAP-2-desc" body="Turn observations into one honest picture with identities, uncertainty, and context."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-2.1" name="Maintain one multi-sensor track picture with uncertainty">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-2.2" name="Keep tracks through gaps with visible quality">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-2.3" name="Register sensors against each other">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-2.4" name="Track dense groups and count targets">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-2.5" name="Maintain a clutter-tolerant surface picture">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-2.6" name="Classify and identify with evidence and confidence">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-2.7" name="Keep one identity across gaps, sorties, sessions, and peers">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-2.8" name="Predict trajectory, time to impact, closest approach">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-2.9" name="Detect anomalies in tracks and feeds">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-2.10" name="Fuse terrain, imagery, point clouds, and map layers">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-2.11" name="Answer geometric questions">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-2.12" name="Maintain pattern of life and order of battle">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-3" name="Decide">
        <ownedComment xmi:id="CAP-3-desc" body="Turn the picture into a policy-checked recommendation for a human."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-3.1" name="Maintain the defended-asset list">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-3.2" name="Score threat and priority per track">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-3.3" name="Recommend the cheapest adequate assignment">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-3.4" name="Compute intercept geometry">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-3.5" name="Offer alternatives, what-if, and rationale">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-3.6" name="Enforce rules of engagement">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-3.7" name="Manage the queue under saturation">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-3.8" name="Recommend fires tasks with deconfliction">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-3.9" name="Recommend sensor re-tasking under degradation">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-4" name="Act (recommend and authorize)">
        <ownedComment xmi:id="CAP-4-desc" body="Put the recommendation in front of the person who holds authority, record what they decide, and hand off; never act without that record."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-4.1" name="Present recommendations for decision">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-4.2" name="Record every decision">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-4.3" name="Never execute without a recorded human decision">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-4.4" name="Hand off to effector systems with provenance">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-4.5" name="Warn assets and authorities">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-4.6" name="Track engagements and assess effects">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-4.7" name="Assist roles without authority">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-5" name="Sustain">
        <ownedComment xmi:id="CAP-5-desc" body="Keep the sector operating, learning, and honest over time and through outages."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-5.1" name="Journal every event durably">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-5.2" name="Replay and rehearse">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-5.3" name="Produce reports and measures from the journal">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-5.4" name="Operate disconnected and reconcile">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-5.5" name="Report health honestly and run the alert lifecycle">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-5.6" name="Manage configuration baselines and mission plans">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-5.7" name="Govern algorithm and model baselines">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-5.8" name="Support the battle rhythm">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-5.9" name="Provide role-based workspaces and workflow">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-5.10" name="Meet performance budgets per profile">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-6" name="Secure">
        <ownedComment xmi:id="CAP-6-desc" body="Control who can see and do what, and prove it afterwards."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-6.1" name="Authenticate operators and callers">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-6.2" name="Authorize by role, class, and layer">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-6.3" name="Audit everything that matters">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-6.4" name="Protect data in transit and at rest">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-6.5" name="Assure the supply chain">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-6.6" name="Mark and enforce releasability">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-6.7" name="Treat external input as untrusted">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-7" name="Integrate">
        <ownedComment xmi:id="CAP-7-desc" body="Be one node in a system of systems."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-7.1" name="Expose a versioned interface">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-7.2" name="Speak the domain's interoperability standards">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-7.3" name="Run as desktop, on-prem node, or cloud node">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="CAP-7.4" name="Exchange with peers and coalition">
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="PKG-operational_performers" name="Operational Performers">
      <packagedElement xmi:type="uml:Class" xmi:id="OP-01" name="Operator">
        <ownedComment xmi:id="OP-01-desc" body="Runs the live picture for a domain at a site or the sector; decides engagements within delegated authority."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OP-02" name="Supervisor">
        <ownedComment xmi:id="OP-02-desc" body="Runs the sector; manages the recommendation queue, weapons control status, holds, degraded-state acknowledgement, reconciliation conflicts, plan apply."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OP-03" name="Analyst">
        <ownedComment xmi:id="OP-03-desc" body="Works the recorded record; replay, after-action review, reports, measures, model promotion evidence."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OP-04" name="Sensor manager">
        <ownedComment xmi:id="OP-04-desc" body="Owns sensor readiness, modes, coverage, tasking, and calibration."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OP-05" name="Administrator">
        <ownedComment xmi:id="OP-05-desc" body="Owns configuration baselines, accounts and roles, the node, and the audit record."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OP-06" name="Intelligence analyst">
        <ownedComment xmi:id="OP-06-desc" body="Owns requirements and tasking, identification evidence and declarations, order of battle, pattern of life, dissemination."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OP-07" name="Planner">
        <ownedComment xmi:id="OP-07-desc" body="Owns defended-asset list drafts, laydown and coverage planning, mission plans, rehearsal."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OP-08" name="Commander">
        <ownedComment xmi:id="OP-08-desc" body="Holds the authorities the others act under; may decide directly."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OP-10" name="Sector command post">
        <ownedComment xmi:id="OP-10-desc" body="The sector's command post; hosts the service node, the supervisor, operators, sensor manager, planner, intelligence analyst (vignettes, SCP)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OP-11" name="Site defense cell">
        <ownedComment xmi:id="OP-11-desc" body="A defended site's cell with a desktop and local sensors and effectors (vignettes, OPS and HAF)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OP-12" name="Port defense cell">
        <ownedComment xmi:id="OP-12-desc" body="The port's cell with a desktop, coastal sensors, patrol craft (vignettes, KAL)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OP-20" name="Higher command">
        <ownedComment xmi:id="OP-20-desc" body="Sets rules of engagement; receives status, warnings, reports, order of battle."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OP-21" name="Neighbouring sector">
        <ownedComment xmi:id="OP-21-desc" body="Exchanges tracks and warnings; hands over raids."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OP-22" name="Fire units and effector systems">
        <ownedComment xmi:id="OP-22-desc" body="Receive decided assignments; report readiness and outcomes."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OP-23" name="Sensor operators and maintainers">
        <ownedComment xmi:id="OP-23-desc" body="Operate and maintain sensors; modes, faults, calibration."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OP-24" name="Civil aviation authority and airport">
        <ownedComment xmi:id="OP-24-desc" body="Corridors, flight plans, ADS-B; receive warnings of engagements."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OP-25" name="Port and maritime authorities">
        <ownedComment xmi:id="OP-25-desc" body="AIS, harbour operations, barriers; receive warnings."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OP-26" name="Coalition partners">
        <ownedComment xmi:id="OP-26-desc" body="Picture and product exchange with releasability."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OP-27" name="Accreditors and auditors">
        <ownedComment xmi:id="OP-27-desc" body="Need evidence that the system enforces policy and records decisions."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OP-30" name="Command-and-control system (Gungnir)">
        <ownedComment xmi:id="OP-30-desc" body="The logical performer that exhibits every system capability; realized by the desktop and the service node."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OP-31" name="Operator workstation">
        <ownedComment xmi:id="OP-31-desc" body="The desktop (gungnir-app) with embedded or remote services."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OP-32" name="Sector service node">
        <ownedComment xmi:id="OP-32-desc" body="The headless node (gungnir-node) that is the system of record in connected profiles."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OP-33" name="Sensor network">
        <ownedComment xmi:id="OP-33-desc" body="The sensors feeding the sector, logically part of the C2 system's inputs; physical sensors are actual resources."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OP-34" name="Effector interface">
        <ownedComment xmi:id="OP-34-desc" body="The handoff boundary to fire units and effector systems (CAP-4.4)."/>
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="PKG-operational_activities" name="Operational Activities">
      <packagedElement xmi:type="uml:Class" xmi:id="OA-01" name="Ingest and validate observations">
        <ownedComment xmi:id="OA-01-desc" body="Bring sensor, cooperative, peer, and human reports in; validate; quarantine; carry provenance."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-02" name="Maintain the track picture">
        <ownedComment xmi:id="OA-02-desc" body="Initiate, update, coast, and delete tracks from all sources with uncertainty and quality."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-03" name="Identify tracks">
        <ownedComment xmi:id="OA-03-desc" body="Classify and identify from kinematic, signature, cooperative, and human evidence with stated confidence."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-04" name="Assess threat and priority">
        <ownedComment xmi:id="OA-04-desc" body="Predict path, asset threatened, time to impact, closest approach; score against the defended-asset list."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-05" name="Recommend assignments">
        <ownedComment xmi:id="OA-05-desc" body="Propose the cheapest adequate resource-to-track assignment within readiness, geometry, and policy."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-06" name="Check policy">
        <ownedComment xmi:id="OA-06-desc" body="Evaluate identification criteria, weapons control status, authority, geofences, and restrictions; produce a verdict."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-07" name="Decide">
        <ownedComment xmi:id="OA-07-desc" body="A human accepts, overrides, rejects, holds, or lets expire; the decision is recorded."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-08" name="Hand off to effectors">
        <ownedComment xmi:id="OA-08-desc" body="Pass decided assignments to fire units and effector systems with provenance."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-09" name="Warn assets and authorities">
        <ownedComment xmi:id="OA-09-desc" body="Warn defended assets, units, and civil authorities with lead time; record the warning."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-10" name="Assess engagement effects">
        <ownedComment xmi:id="OA-10-desc" body="Track the engaged threat, record the outcome, supersede plans, re-plan the remainder."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-11" name="Journal and report">
        <ownedComment xmi:id="OA-11-desc" body="Journal every event; produce summaries, reports, and measures after action."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-12" name="Manage sensors and coverage">
        <ownedComment xmi:id="OA-12-desc" body="Set modes, task sensors, keep calibration, compute coverage and gaps over terrain."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-13" name="Detect and correlate degradation">
        <ownedComment xmi:id="OA-13-desc" body="Detect sensor loss, ingest gaps, clock skew, quality collapse; correlate into incidents."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-14" name="Re-task sensors">
        <ownedComment xmi:id="OA-14-desc" body="Change modes and tasking to restore the most valuable coverage; show before and after."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-15" name="Exchange the picture with peers">
        <ownedComment xmi:id="OA-15-desc" body="Send and receive tracks, warnings, and products with peers, higher command, and partners."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-16" name="Flag anomalies">
        <ownedComment xmi:id="OA-16-desc" body="Detect AIS-off, spoofing, loitering, and implausible feeds as alerts through the lifecycle."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-17" name="State collection requirements">
        <ownedComment xmi:id="OA-17-desc" body="Express an information requirement with area, question, priority, and window; task or decline it."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-18" name="Fuse identification evidence">
        <ownedComment xmi:id="OA-18-desc" body="Combine evidence into identities with confidence; retain the evidence with the track."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-19" name="Maintain entities and order of battle">
        <ownedComment xmi:id="OA-19-desc" body="Keep global identities across sessions; merge and split; accumulate pattern of life."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-20" name="Disseminate products">
        <ownedComment xmi:id="OA-20-desc" body="Release identities, warnings, and products to roles and peers with marking."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-21" name="Set the defended-asset list and priorities">
        <ownedComment xmi:id="OA-21-desc" body="Define protected assets, priorities, and warning obligations."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-22" name="Plan the laydown">
        <ownedComment xmi:id="OA-22-desc" body="Place sensors and effectors; compute coverage and gaps over terrain."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-23" name="Configure policy">
        <ownedComment xmi:id="OA-23-desc" body="Set identification criteria, weapons control status, authorities, restrictions as geofences, delegations."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-24" name="Validate and apply the plan">
        <ownedComment xmi:id="OA-24-desc" body="Validate a configuration baseline; apply it with audit."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-25" name="Rehearse">
        <ownedComment xmi:id="OA-25-desc" body="Replay a scenario through the pipeline under a plan; review recommendations and gaps."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-26" name="Review after action">
        <ownedComment xmi:id="OA-26-desc" body="Review the journal, measure, record lessons."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-27" name="Operate disconnected">
        <ownedComment xmi:id="OA-27-desc" body="Fall back to embedded services; keep journaling; queue for forwarding; act under pre-delegated authority."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-28" name="Reconcile journals">
        <ownedComment xmi:id="OA-28-desc" body="Forward the queue; merge local and node journals; report conflicts."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-29" name="Resolve conflicts">
        <ownedComment xmi:id="OA-29-desc" body="Resolve reported decision conflicts under the arbitration rule; update the record."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-30" name="Recommend a fires task">
        <ownedComment xmi:id="OA-30-desc" body="Propose a fires task with target location and uncertainty, time window, and deconfliction."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-31" name="Manage the decision queue">
        <ownedComment xmi:id="OA-31-desc" body="Order pending decisions by priority and time remaining; apply delegation; escalate; time out."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-32" name="Assist with questions and drafts">
        <ownedComment xmi:id="OA-32-desc" body="Answer questions about the picture and draft products with provenance and no authority."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-33" name="Govern algorithm and model baselines">
        <ownedComment xmi:id="OA-33-desc" body="Validate, promote, and roll back the algorithm and model configuration in force."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-34" name="Authenticate and authorize">
        <ownedComment xmi:id="OA-34-desc" body="Establish who a caller is and what their role permits before any action."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-35" name="Audit">
        <ownedComment xmi:id="OA-35-desc" body="Record every decision, configuration change, promotion, tasking, and assistant exchange append-only."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="OA-36" name="Exchange cooperative identity">
        <ownedComment xmi:id="OA-36-desc" body="Receive IFF, ADS-B, AIS, and blue-force identity and attach it as evidence."/>
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="PKG-services" name="Services">
      <packagedElement xmi:type="uml:Class" xmi:id="SV-01" name="Tracking">
        <ownedComment xmi:id="SV-01-desc" body="Detections in, tracks with quality out; health honest (pipeline not implemented)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-02" name="Intercept planning">
        <ownedComment xmi:id="SV-02-desc" body="Tracks and resources in, a PlanView out; last-good-plan on over-budget solves (allocator not implemented)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-03" name="Event bus">
        <ownedComment xmi:id="SV-03-desc" body="Broadcast publish and subscribe with sequence-stamped envelopes."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-04" name="Event journal">
        <ownedComment xmi:id="SV-04-desc" body="Append-only JSON-lines session journal; read back for replay; retention."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-05" name="Time authority">
        <ownedComment xmi:id="SV-05-desc" body="Wall and replay clocks; source versus receipt time; late-data policy."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-06" name="Configuration store">
        <ownedComment xmi:id="SV-06-desc" body="Load, validate, and save versioned configuration baselines."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-07" name="Mission lifecycle">
        <ownedComment xmi:id="SV-07-desc" body="Create, live, save, load, replay, close a session."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-08" name="Ingest gateway">
        <ownedComment xmi:id="SV-08-desc" body="Adapters behind a validating, authenticating, quarantining gateway (SourceAuthenticator, IngestGateway)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-09" name="Sensor registry">
        <ownedComment xmi:id="SV-09-desc" body="Sensor records, modes with a transition table, coverage regions."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-10" name="Interop catalogue and codecs">
        <ownedComment xmi:id="SV-10-desc" body="Schema catalogue with version negotiation; Arrow form; ASTERIX and STANAG codecs (NotImplemented)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-11" name="Identity resolution">
        <ownedComment xmi:id="SV-11-desc" body="Global entity identity across session tracks with merge and split lineage."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-12" name="Identification">
        <ownedComment xmi:id="SV-12-desc" body="Evidence fusion to friend, hostile, neutral, unknown with a margin rule."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-13" name="Geospatial">
        <ownedComment xmi:id="SV-13-desc" body="Geofence containment, map layers, coordinate reference governance."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-14" name="Analytics">
        <ownedComment xmi:id="SV-14-desc" body="Line of sight, viewshed, coverage volumes, route deconfliction over terrain."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-15" name="Policy">
        <ownedComment xmi:id="SV-15-desc" body="Geofence and readiness verdicts through a chain that never self-approves."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-16" name="Approval workflow">
        <ownedComment xmi:id="SV-16-desc" body="Pending approvals and decision records; nothing actionable without one."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-17" name="Threat assessment">
        <ownedComment xmi:id="SV-17-desc" body="Risk scores and the reward matrix for the allocator."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-18" name="Decision support">
        <ownedComment xmi:id="SV-18-desc" body="Rationale (real); alternatives and what-if (trait surface)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-19" name="Model registry">
        <ownedComment xmi:id="SV-19-desc" body="Validate, promote, roll back algorithm baselines."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-20" name="Authentication">
        <ownedComment xmi:id="SV-20-desc" body="Credential to OperatorId (trait only; mechanism D-02)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-21" name="Authorization">
        <ownedComment xmi:id="SV-21-desc" body="Role-to-action matrix; unknown operators permitted nothing."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-22" name="Audit log">
        <ownedComment xmi:id="SV-22-desc" body="Append-only audit entries per gated action."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-23" name="API v1">
        <ownedComment xmi:id="SV-23-desc" body="Snapshot, event stream, detection submission, plan decision, health; transport pending."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-24" name="Health monitor">
        <ownedComment xmi:id="SV-24-desc" body="Health snapshot from service flags; alert correlation; watchdog."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-25" name="Store-and-forward and reconciliation">
        <ownedComment xmi:id="SV-25-desc" body="Bounded queue while disconnected; journal merge with conflict reporting."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-26" name="Shared picture and arbitration">
        <ownedComment xmi:id="SV-26-desc" body="Apply node envelopes to a projection; role-rank arbitration of conflicts."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-27" name="Operator workflow">
        <ownedComment xmi:id="SV-27-desc" body="Role workspace layouts; alert lifecycle; cases and annotations."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-28" name="Replay">
        <ownedComment xmi:id="SV-28-desc" body="Deterministic playback of a journal under the replay clock."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-29" name="Reporting">
        <ownedComment xmi:id="SV-29-desc" body="Reports and exports with every figure traceable to the journal."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-30" name="Remote backends">
        <ownedComment xmi:id="SV-30-desc" body="RemoteTrackingService and RemoteInterceptService over the API with an outbox; transport pending."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-31" name="Data loading">
        <ownedComment xmi:id="SV-31-desc" body="Point cloud, VTK, terrain, glTF loaders off the UI thread (surface only)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-32" name="Point-cloud fusion">
        <ownedComment xmi:id="SV-32-desc" body="CPU reference and GPU ICP registration (trait surface)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-33" name="Tracking metrics">
        <ownedComment xmi:id="SV-33-desc" body="MOTA, MOTP, purity, fragmentation against truth."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SV-34" name="Scenario generation">
        <ownedComment xmi:id="SV-34-desc" body="The five engineering scenarios with truth."/>
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="PKG-resources" name="Resources">
      <packagedElement xmi:type="uml:Class" xmi:id="RS-allocation" name="gungnir-allocation">
        <ownedComment xmi:id="RS-allocation-desc" body="Bellman/DP resource-to-track assignment."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-analytics" name="gungnir-analytics">
        <ownedComment xmi:id="RS-analytics-desc" body="Advanced 3D analytical functions -- line-of-sight, viewshed, sensor-coverage volumes, terrain masking, route deconfliction -- as standalone CPU services rendered by gungnir-viewport3d rather than embedded in it. docs/gungnir-capabilities.md §5.3 -- Medium."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-api" name="gungnir-api">
        <ownedComment xmi:id="RS-api-desc" body="Versioned, security-gated external contract (v1: snapshot, event stream, detection submit, plan decision) so remote desktops, peer C2 systems, analytics tools, or enterprise data services can integrate with a service node. Transport-neutral types here; the HTTP/JSON + WebSocket transport is the next stack addition. docs/gungnir-capabilities.md §5.5 -- High."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-app" name="gungnir-app">
        <ownedComment xmi:id="RS-app-desc" body="eframe desktop binary: bootstrap + AppState + update loop. The one crate allowed to depend on everything. Intentionally thin -- wiring, not logic, per rust-ui-architecture-coding-standards.md §1. Selects the embedded or remote services backend from gungnir-config (ARCHITECTURE.md §8) and runs eframe with Renderer::Glow so three-d has a GL context."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-assessment" name="gungnir-assessment">
        <ownedComment xmi:id="RS-assessment-desc" body="Threat/risk scoring, predicted time-to-impact, asset exposure, confidence-aware prioritization feeding the allocation decision's reward matrix. docs/gungnir-capabilities.md §5.4 -- Medium."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-association" name="gungnir-association">
        <ownedComment xmi:id="RS-association-desc" body="NN/GNN, Hungarian/JV, gating, JPDA, MHT."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-collab" name="gungnir-collab">
        <ownedComment xmi:id="RS-collab-desc" body="Collaboration &amp; multi-user concurrency: shared operational picture across desktops connected to one node, concurrent annotations, and authority conflict resolution between operators' decisions. docs/gungnir-capabilities.md §5.6 -- Medium. Server-authoritative mission state lives on the node (ARCHITECTURE.md §8)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-command" name="gungnir-command">
        <ownedComment xmi:id="RS-command-desc" body="Human-approval workflow sitting on top of gungnir-policy's verdicts -- the operator-facing accept/override/reject boundary for an intercept plan, with every decision recorded. docs/gungnir-capabilities.md §5.4 -- Critical. Human-owned changes. Pairs with gungnir-policy."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-config" name="gungnir-config">
        <ownedComment xmi:id="RS-config-desc" body="Managed, versioned, validated configuration for sensor definitions, filter/association selection, thresholds, allocation weights, backend selection (embedded or remote), and service-node settings. docs/gungnir-capabilities.md §5.1 -- High. Pairs with gungnir-mission."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-coord" name="gungnir-coord">
        <ownedComment xmi:id="RS-coord-desc" body="ECEF/ENU/NED/geodetic coordinate frame transforms."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-core" name="gungnir-core">
        <ownedComment xmi:id="RS-core-desc" body="CV/CA/CT motion models -- F/Q generation (exact-match closed-form oracle only) -- plus the identifier, lifecycle-status, and PSD-assertion primitives every higher crate shares (docs/agentic-coding-standards.md §1.2, §2.1)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-data-fusion" name="gungnir-data-fusion">
        <ownedComment xmi:id="RS-data-fusion-desc" body="GPU-accelerated point cloud registration/fusion (point-to-plane ICP) on wgpu compute, per rust-3d-data-ecosystem-build-vs-adopt.md §3. The one genuine ecosystem gap identified -- kept as its own crate, separate from gungnir-data, because it's the only data-layer crate that needs a wgpu::Device (borrowed from gungnir-render)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-data" name="gungnir-data">
        <ownedComment xmi:id="RS-data-desc" body="File I/O for point cloud / VTK scientific mesh / terrain / glTF, per rust-3d-data-ecosystem-build-vs-adopt.md §1. No egui/three-d/wgpu dependency -- unit-testable with plain cargo test."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-decision" name="gungnir-decision">
        <ownedComment xmi:id="RS-decision-desc" body="Course-of-action generation and comparison, constraint handling, what-if simulation against a live snapshot, and recommendation explanations -- beyond single-solution DP allocation. docs/gungnir-capabilities.md §5.4 -- Medium."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-eventing" name="gungnir-eventing">
        <ownedComment xmi:id="RS-eventing-desc" body="Transport-neutral broadcast event bus (in-process today; a durable/replayable log or network stream behind the same trait later). docs/gungnir-capabilities.md §5.1 -- High. Replaces the UI polling a mutable slice every frame."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-filters" name="gungnir-filters">
        <ownedComment xmi:id="RS-filters-desc" body="KF/EKF/UKF/PF/IMM/sqrt-UDU/RTS state estimation."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-fusion-async" name="gungnir-fusion-async">
        <ownedComment xmi:id="RS-fusion-async-desc" body="OOS handling / multi-rate async fusion pipeline. The only crate that uses the tokio runtime; the runtime is owned by the host binary."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-fuzz" name="gungnir-fuzz">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-geo" name="gungnir-geo">
        <ownedComment xmi:id="RS-geo-desc" body="Coordinate-reference-system governance, map/imagery layers, geocoding, vector features, spatial indexing, and geofencing. docs/gungnir-capabilities.md §5.3 -- Medium."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-identification" name="gungnir-identification">
        <ownedComment xmi:id="RS-identification-desc" body="Friend/foe/unknown track classification from an evidence-fusion process. gungnir-capabilities.md §5.3 -- Medium."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-identity" name="gungnir-identity">
        <ownedComment xmi:id="RS-identity-desc" body="Persistent global track/entity identity across feeds -- aliases, merge/split history, supersession -- beyond the tracking core's internal track IDs. docs/gungnir-capabilities.md §5.3 -- High."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-ingest" name="gungnir-ingest">
        <ownedComment xmi:id="RS-ingest-desc" body="Protocol-specific adapters plus a validation/authentication/quarantine gateway that normalizes live, recorded, and simulated sources into the canonical DetectionView before anything reaches the Tracking Service. docs/gungnir-capabilities.md §5.2 -- Critical. Gateway changes are human-owned."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-intercept-service" name="gungnir-intercept-service">
        <ownedComment xmi:id="RS-intercept-service-desc" body="App-facing facade over gungnir-allocation + gungnir-coord: turns current tracks + available resources into an intercept/tasking plan (gungnir-model PlanView). Kept separate from gungnir-tracking-service because it answers 'what should we do' rather than 'where are they' -- see ARCHITECTURE.md §2."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-interop" name="gungnir-interop">
        <ownedComment xmi:id="RS-interop-desc" body="Data standards &amp; interoperability: the schema catalog with version negotiation, the Arrow representation of detections, and the ASTERIX/STANAG codec boundary that gungnir-ingest adapters and gungnir-reporting exports use. docs/gungnir-capabilities.md §5.6 and §1 (interop schema row) -- Medium."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-metrics" name="gungnir-metrics">
        <ownedComment xmi:id="RS-metrics-desc" body="MOTA/MOTP, purity/fragmentation, track-to-truth assignment."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-mission" name="gungnir-mission">
        <ownedComment xmi:id="RS-mission-desc" body="Mission/session lifecycle: create/load/save/replay/close, plus scenario binding. gungnir-capabilities.md §5.1 -- High. Pairs with gungnir-config."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-ml" name="gungnir-ml">
        <ownedComment xmi:id="RS-ml-desc" body="The model and feature-extractor traits learned models are held to, a fake model for the consumers' tests, and the dataset extraction from test-track sets into the Arrow form docs/ml/data-pipeline.md documents (GAP-077, GAP-079). OnnxModel, the ort-backed real Model, is real compiling code behind the onnx-runtime feature (off by default: agentic-coding-standards.md §2.9, D-40) -- ort 2.0.0-rc.13's load-dynamic path panics rather than erroring when no compatible ONNX Runtime library is reachable, so it must not run inside default `cargo test`. ModelSet::load reports which named models are unavailable rather than pretending."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-model" name="gungnir-model">
        <ownedComment xmi:id="RS-model-desc" body="Canonical, versioned operational data model -- TrackView/DetectionView/ResourceView/PlanView and friends, with provenance, quality, identity, timestamps, and classification as first-class fields. Foundational/Critical per docs/gungnir-capabilities.md §5.1 -- the service facades and every productization crate build on this one."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-modelops" name="gungnir-modelops">
        <ownedComment xmi:id="RS-modelops-desc" body="Registry for selecting, tuning, comparing, validating, promoting, and rolling back filter/association configurations by mission profile, and (GAP-078) the model artefact -- name, version, hash, evaluation record -- a baseline optionally carries alongside its tracking configuration through the same promotion state machine. gungnir-capabilities.md §5.4 -- Medium."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-node" name="gungnir-node">
        <ownedComment xmi:id="RS-node-desc" body="Headless service-node binary for the on-prem and cloud profiles (ARCHITECTURE.md §8.1): hosts the services layer and the authoritative gungnir-store journal behind gungnir-api. Targets Linux x86_64 containers; depends on no UI, three-d, or wgpu crate."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-observability" name="gungnir-observability">
        <ownedComment xmi:id="RS-observability-desc" body="Production-facing metrics, structured logs, distributed traces, health checks, watchdogs, and alert correlation -- extends the developer-facing tracing instrumentation into an operator-facing system-status capability. gungnir-capabilities.md §5.5 -- High."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-oracle" name="gungnir-oracle">
        <ownedComment xmi:id="RS-oracle-desc" body="Differential-test harness against Python/MATLAB oracles. Depends on everything; nothing depends on it."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-policy" name="gungnir-policy">
        <ownedComment xmi:id="RS-policy-desc" body="Authority model, geofence/no-go enforcement, and policy evaluation sitting in front of the Intercept Planning Service's output. docs/gungnir-capabilities.md §5.4 -- Critical. Human-owned changes (agentic-workflow.md). Pairs with gungnir-command."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-remote" name="gungnir-remote">
        <ownedComment xmi:id="RS-remote-desc" body="Remote implementations of the TrackingService and InterceptService traits that talk to a gungnir-node over gungnir-api, so the desktop switches between the embedded and connected profiles without any UI change (ARCHITECTURE.md §8.2). Store-and-forward while disconnected."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-render" name="gungnir-render">
        <ownedComment xmi:id="RS-render-desc" body="Shared wgpu device/queue/surface management + egui&lt;-&gt;wgpu render pass wiring, per rust-ui-architecture-coding-standards.md §1. No tracking-domain knowledge."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-replay" name="gungnir-replay">
        <ownedComment xmi:id="RS-replay-desc" body="Deterministic session playback, timeline scrubbing, and recorded-data replay -- reads gungnir-store's event journal through a gungnir-time ReplayClockAuthority. docs/gungnir-capabilities.md §5.6 -- Lower."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-reporting" name="gungnir-reporting">
        <ownedComment xmi:id="RS-reporting-desc" body="Mission reports and export packages with provenance preserved: every figure traces back to the recorded event journal it was computed from. docs/gungnir-capabilities.md §5.6 -- Lower."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-resilience" name="gungnir-resilience">
        <ownedComment xmi:id="RS-resilience-desc" body="Resilience &amp; disconnected operations: store-and-forward of envelopes while a node is unreachable, checkpoints, and journal reconciliation after the link returns (ARCHITECTURE.md §8.4). docs/gungnir-capabilities.md §5.6 -- Medium."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-rfs" name="gungnir-rfs">
        <ownedComment xmi:id="RS-rfs-desc" body="PHD/CPHD, GLMB/LMB random finite set filters."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-scenario" name="gungnir-scenario">
        <ownedComment xmi:id="RS-scenario-desc" body="Ground-truth + sensor simulation, five-scenario generator. Test/bench dependency only -- never a normal dependency of a production crate."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-security" name="gungnir-security">
        <ownedComment xmi:id="RS-security-desc" body="Authentication, role/attribute-based authorization, encryption in transit and at rest, secrets/key management, signed binaries and configuration, audit logging. gungnir-capabilities.md §5.5 -- Critical."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-sensor-management" name="gungnir-sensor-management">
        <ownedComment xmi:id="RS-sensor-management-desc" body="Sensor registry (identity, modality, location, calibration version, operating state) plus tasking, mode management, and coverage planning. docs/gungnir-capabilities.md §5.2 -- High."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-store" name="gungnir-store">
        <ownedComment xmi:id="RS-store-desc" body="Durable storage for mission sessions (an append-only JSON-lines event journal), replay artifacts, configuration baselines, and audit logs, with an explicit retention/deletion policy. docs/gungnir-capabilities.md §5.1 -- High."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-testkit" name="gungnir-testkit">
        <ownedComment xmi:id="RS-testkit-desc" body="Shared proptest strategies for the tracking core. Depends on no workspace crate (so it can be a dev-dependency of every one of them without a dev-dependency cycle); nothing depends on it at runtime."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-time" name="gungnir-time">
        <ownedComment xmi:id="RS-time-desc" body="Clock discipline across sensors: source-time vs. receipt-time semantics, late-data policy, deterministic replay-time control, synchronization health. docs/gungnir-capabilities.md §5.2 -- Critical."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-track-fusion" name="gungnir-track-fusion">
        <ownedComment xmi:id="RS-track-fusion-desc" body="Track-to-track fusion (CI/info-matrix), sensor registration/bias."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-track" name="gungnir-track">
        <ownedComment xmi:id="RS-track-desc" body="Track lifecycle: init/confirm/coast/delete."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-tracking-service" name="gungnir-tracking-service">
        <ownedComment xmi:id="RS-tracking-service-desc" body="App-facing facade over the tracking/estimation core. Owns the IMM bank, associator, track manager, and async multi-rate/OOS fusion pipeline behind one trait, and projects the core's kinematic Track into the canonical gungnir-model TrackView. See ARCHITECTURE.md §2."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-ui" name="gungnir-ui">
        <ownedComment xmi:id="RS-ui-desc" body="2D egui dashboard panels + centralized theme, per rust-ui-architecture-coding-standards.md §1/§6. One file per panel; no magic layout numbers. Reads gungnir-model views only; holds no state of its own."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-viewport3d" name="gungnir-viewport3d">
        <ownedComment xmi:id="RS-viewport3d-desc" body="three-d scene setup, camera, streaming/scientific data bridges, and live track/intercept rendering, drawn into eframe's OpenGL (glow) context. Combines rust-3d-data-ecosystem-build-vs-adopt.md §2 with gungnir-model views -- see ARCHITECTURE.md §4-5 for why track rendering lives here rather than in a translation crate."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="RS-workflow" name="gungnir-workflow">
        <ownedComment xmi:id="RS-workflow-desc" body="Human factors &amp; operator workflow: role-based workspace layouts, the alert acknowledgement/escalation lifecycle, annotations and cases -- turning a set of panels into a designed operator workflow. docs/gungnir-capabilities.md §5.6 -- Medium."/>
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="PKG-personnel_types" name="Personnel Types">
      <packagedElement xmi:type="uml:Class" xmi:id="PT-01" name="Operator">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="PT-02" name="Supervisor">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="PT-03" name="Analyst">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="PT-04" name="Sensor manager">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="PT-05" name="Administrator">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="PT-06" name="Intelligence analyst">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="PT-07" name="Planner">
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="PT-08" name="Commander">
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="PKG-standards" name="Standards">
      <packagedElement xmi:type="uml:Class" xmi:id="SD-01" name="Gungnir canonical schema v1">
        <ownedComment xmi:id="SD-01-desc" body="The versioned JSON form of every view and event; the journal and the API carry it."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SD-02" name="Apache Arrow (arrow 53)">
        <ownedComment xmi:id="SD-02-desc" body="Columnar form of detections for analytics and bulk exchange."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SD-03" name="ASTERIX Category 048 (Eurocontrol)">
        <ownedComment xmi:id="SD-03-desc" body="Radar target reports; codec returns NotImplemented (GAP-064)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SD-04" name="STANAG 4676 (NATO ISR tracking standard)">
        <ownedComment xmi:id="SD-04-desc" body="Track exchange with coalition; codec returns NotImplemented (GAP-064)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SD-05" name="JSON (RFC 8259)">
        <ownedComment xmi:id="SD-05-desc" body="Serialization of configuration, journal lines, and API payloads."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SD-06" name="HTTP/1.1 (RFC 9112)">
        <ownedComment xmi:id="SD-06-desc" body="Request and response transport for the API (GAP-041)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SD-07" name="WebSocket (RFC 6455)">
        <ownedComment xmi:id="SD-07-desc" body="The API event stream (GAP-041)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SD-08" name="TLS 1.3 (RFC 8446)">
        <ownedComment xmi:id="SD-08-desc" body="Encryption in transit and mutual authentication of machines (GAP-060)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SD-09" name="AIS (ITU-R M.1371)">
        <ownedComment xmi:id="SD-09-desc" body="Cooperative maritime identity (GAP-010)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SD-10" name="ADS-B 1090 ES (RTCA DO-260B)">
        <ownedComment xmi:id="SD-10-desc" body="Cooperative air identity (GAP-010)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SD-11" name="UUID version 7 (RFC 9562)">
        <ownedComment xmi:id="SD-11-desc" body="Textual and time-ordered form of GlobalEntityId (GAP-069)."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SD-12" name="OCI container image">
        <ownedComment xmi:id="SD-12-desc" body="Packaging of the service node for Linux x86_64."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SD-13" name="Software bill of materials (CycloneDX JSON) and signed releases">
        <ownedComment xmi:id="SD-13-desc" body="Release evidence per docs/release-governance.md; exercised under GAP-061."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SD-14" name="UAF 1.2 (OMG)">
        <ownedComment xmi:id="SD-14-desc" body="The framework these views follow."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SD-15" name="TOGAF 10 ADM">
        <ownedComment xmi:id="SD-15-desc" body="The method plan 10 follows; references these views."/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="SD-16" name="Cursor-on-Target (CoT)">
        <ownedComment xmi:id="SD-16-desc" body="Exchange with a participant that holds no machine identity here; no codec and no sink exist (GAP-090, GAP-091)."/>
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="PKG-projects" name="Projects">
      <packagedElement xmi:type="uml:Class" xmi:id="PJ-I1" name="Increment 1">
