        <packagedElement xmi:type="uml:InstanceSpecification" xmi:id="EAID_F4198540_395C_7234_4D4E_653E4F6B8E06" name="Effector systems" visibility="public"/>
        <packagedElement xmi:type="uml:InstanceSpecification" xmi:id="EAID_F2F535E7_5731_D8E1_5255_157D735984F7" name="Build and release infrastructure" visibility="public"/>
