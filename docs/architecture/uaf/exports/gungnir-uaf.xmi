        <packagedElement xmi:type="uml:Class" xmi:id="EAID_89357FFF_14B5_BA74_8B5E_FC9F1A6AEE82" name="Plan 10 TOGAF ADM documentation" visibility="public"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Package" xmi:id="EAPK_34896D57_5A99_007A_944A_6BA06B9C3D7F" name="Actual Resources Connectivity Ar-Cn" visibility="public">
