    <packagedElement xmi:type="uml:Package" xmi:id="PKG-Sv-Cn" name="Service Connectivity Sv-Cn">
        <packagedElement xmi:type="uml:Class" xmi:id="SV-01" name="Tracking" visibility="public">
          <ownedComment xmi:id="SV-01-desc" body="Detections in, tracks with quality out; health honest (pipeline not implemented)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-02" name="Intercept planning" visibility="public">
          <ownedComment xmi:id="SV-02-desc" body="Tracks and resources in, a PlanView out; last-good-plan on over-budget solves (allocator not implemented)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-03" name="Event bus" visibility="public">
          <ownedComment xmi:id="SV-03-desc" body="Broadcast publish and subscribe with sequence-stamped envelopes."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-04" name="Event journal" visibility="public">
          <ownedComment xmi:id="SV-04-desc" body="Append-only JSON-lines session journal; read back for replay; retention."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-05" name="Time authority" visibility="public">
          <ownedComment xmi:id="SV-05-desc" body="Wall and replay clocks; source versus receipt time; late-data policy."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-06" name="Configuration store" visibility="public">
          <ownedComment xmi:id="SV-06-desc" body="Load, validate, and save versioned configuration baselines."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-07" name="Mission lifecycle" visibility="public">
          <ownedComment xmi:id="SV-07-desc" body="Create, live, save, load, replay, close a session."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-08" name="Ingest gateway" visibility="public">
          <ownedComment xmi:id="SV-08-desc" body="Adapters behind a validating, authenticating, quarantining gateway (SourceAuthenticator, IngestGateway)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-09" name="Sensor registry" visibility="public">
          <ownedComment xmi:id="SV-09-desc" body="Sensor records, modes with a transition table, coverage regions."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-10" name="Interop catalogue and codecs" visibility="public">
          <ownedComment xmi:id="SV-10-desc" body="Schema catalogue with version negotiation; Arrow form; ASTERIX and STANAG codecs (NotImplemented)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-11" name="Identity resolution" visibility="public">
          <ownedComment xmi:id="SV-11-desc" body="Global entity identity across session tracks with merge and split lineage."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-12" name="Identification" visibility="public">
          <ownedComment xmi:id="SV-12-desc" body="Evidence fusion to friend, hostile, neutral, unknown with a margin rule."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-13" name="Geospatial" visibility="public">
          <ownedComment xmi:id="SV-13-desc" body="Geofence containment, map layers, coordinate reference governance."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-14" name="Analytics" visibility="public">
          <ownedComment xmi:id="SV-14-desc" body="Line of sight, viewshed, coverage volumes, route deconfliction over terrain."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-15" name="Policy" visibility="public">
          <ownedComment xmi:id="SV-15-desc" body="Geofence and readiness verdicts through a chain that never self-approves."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-16" name="Approval workflow" visibility="public">
          <ownedComment xmi:id="SV-16-desc" body="Pending approvals and decision records; nothing actionable without one."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-17" name="Threat assessment" visibility="public">
          <ownedComment xmi:id="SV-17-desc" body="Risk scores and the reward matrix for the allocator."/>
