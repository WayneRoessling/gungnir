        <packagedElement xmi:type="uml:Class" xmi:id="EAID_631FD798_1C31_991B_0F4C_83D197E6D6A2" name="Sector service node" visibility="public">
          <ownedComment xmi:id="EAID_E336EB06_4EA1_561F_96AC_8E5862D051FE" body="The headless node (gungnir-node) that is the system of record in connected profiles."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_FD450222_42D8_CC94_97AE_B2637E60DC93" name="Sensor network" visibility="public">
          <ownedComment xmi:id="EAID_FADA6002_39D2_BF5C_9E20_F980F320B285" body="The sensors feeding the sector, logically part of the C2 system's inputs; physical sensors are actual resources."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_895F47A7_4998_4B6F_9345_90E003A3CDBF" name="Effector interface" visibility="public">
          <ownedComment xmi:id="EAID_8FFE92DC_E3C5_200D_38F4_A3BE1DC3EB6B" body="The handoff boundary to fire units and effector systems (CAP-4.4)."/>
        </packagedElement>
      </packagedElement>
      <packagedElement xmi:type="uml:Package" xmi:id="EAPK_06A8F781_201E_E77A_4022_0A049F62AD92" name="Operational Processes Op-Pr" visibility="public">
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_5479A7D9_8C9F_AE30_D475_36ED8699B8B6" name="Ingest and validate observations" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_AA75FE93_95FF_4216_B354_61C9165850E6" body="Bring sensor, cooperative, peer, and human reports in; validate; quarantine; carry provenance."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_CAF0186D_852B_3033_DB28_0FE2FFF6ABB9" name="Maintain the track picture" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_26072807_BE75_0EEF_6663_976470065720" body="Initiate, update, coast, and delete tracks from all sources with uncertainty and quality."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_0CF16B14_2922_FC01_42F3_A2C0A37511E7" name="Identify tracks" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_1E5CA14C_41B7_0B26_4B18_D94F90B73BBC" body="Classify and identify from kinematic, signature, cooperative, and human evidence with stated confidence."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_4E7A3764_5C08_7E1A_E8DB_498C0D473FEA" name="Assess threat and priority" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_71CA9BD6_1E91_E069_5546_368D14C400FF" body="Predict path, asset threatened, time to impact, closest approach; score against the defended-asset list."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_9E115E21_6F09_B178_5A15_8EFCB7F42D90" name="Recommend assignments" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_BEA5449D_4C7F_7828_763A_72DFF2CCACB7" body="Propose the cheapest adequate resource-to-track assignment within readiness, geometry, and policy."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_5B7FC327_BC33_80CC_4D2B_8A7FA49F370F" name="Check policy" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_DE7BF621_C4AB_4B2B_E544_BD27664177C6" body="Evaluate identification criteria, weapons control status, authority, geofences, and restrictions; produce a verdict."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_2A4A49A1_AE29_B36A_542E_7DA77FAB8D3E" name="Decide" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_B231C74D_AD1F_70A8_BBE5_8B42F189EDC7" body="A human accepts, overrides, rejects, holds, or lets expire; the decision is recorded."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_D80E0EF2_F4B7_38F6_255A_F7DB4BCE408F" name="Hand off to effectors" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_75323825_F5A2_D270_B1E3_0AF99D170007" body="Pass decided assignments to fire units and effector systems with provenance."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_7A15AAA9_9D0A_EC3F_5A96_BA79C77C2AC4" name="Warn assets and authorities" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_4E66C487_D8AF_705E_C766_0D307EE20AA9" body="Warn defended assets, units, and civil authorities with lead time; record the warning."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_F7B34CD1_A758_7902_AD8D_C5EEFF4A6B3F" name="Assess engagement effects" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_2FB6D3A1_EA5A_1040_06C6_CA8CD0205801" body="Track the engaged threat, record the outcome, supersede plans, re-plan the remainder."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_04E2EBF5_2F18_C2EE_0638_6CD3F06C3E45" name="Journal and report" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_2DB7770B_AED1_2576_B2E8_BF9098979C45" body="Journal every event; produce summaries, reports, and measures after action."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_EB48A66C_DB94_2FBA_85CF_87D182785A47" name="Manage sensors and coverage" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_F2B12EB5_E2EC_EB61_093E_2C70914B6621" body="Set modes, task sensors, keep calibration, compute coverage and gaps over terrain."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_9D61D3BB_1242_D97B_FD6D_CB71D416168E" name="Detect and correlate degradation" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_1721FAC8_F3CB_BC4F_8992_F64FD067C06C" body="Detect sensor loss, ingest gaps, clock skew, quality collapse; correlate into incidents."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_F1DF9896_8DC9_7936_B605_F85B00A08BEA" name="Re-task sensors" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_4F42CC2C_6EF6_6E0D_1A0E_EE2C9CFA9CA2" body="Change modes and tasking to restore the most valuable coverage; show before and after."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_3A938471_9862_72FE_561A_ED1EC8DD8D64" name="Exchange the picture with peers" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_B4C251F2_19FA_63AF_0691_8FF03A3AB10F" body="Send and receive tracks, warnings, and products with peers, higher command, and partners."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_3AE2761E_AA2B_024C_B1FE_7849DB164135" name="Flag anomalies" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_4DA5B7B9_51A1_2D73_FF0A_01049C36600C" body="Detect AIS-off, spoofing, loitering, and implausible feeds as alerts through the lifecycle."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_9CA6FCD8_76C9_C40C_C3F6_0F2123375143" name="State collection requirements" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_84C4F667_E855_ACC4_4AE1_B6C819785141" body="Express an information requirement with area, question, priority, and window; task or decline it."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_A1C721D7_AF0F_B806_1D05_BB29E02D90B7" name="Fuse identification evidence" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_646B24F9_1427_49BA_E56B_47AA5D2E09A4" body="Combine evidence into identities with confidence; retain the evidence with the track."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_79336AB1_46F6_2A27_6B19_12B00FD64C09" name="Maintain entities and order of battle" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_A85AB56E_BB02_0FB2_D5EB_4EA2CD32895F" body="Keep global identities across sessions; merge and split; accumulate pattern of life."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_CE9D002A_9831_5228_36C1_E9237CFA71CA" name="Disseminate products" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_4C489ED7_E8C3_B421_0260_611221E23BEE" body="Release identities, warnings, and products to roles and peers with marking."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_4C8B8DD5_8D77_D6BD_46C4_B791FE46C995" name="Set the defended-asset list and priorities" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_201E68D7_BCAC_4CC9_FD96_277C9573D1C8" body="Define protected assets, priorities, and warning obligations."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_BA51D6E8_AE3B_F02D_D25E_73EB6A513583" name="Plan the laydown" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_9E843AB7_29FC_343F_B0D6_5E65C31CE7B7" body="Place sensors and effectors; compute coverage and gaps over terrain."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_16730A8D_12C6_DB0A_77ED_827918856334" name="Configure policy" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_91573D25_C021_4A6A_4E8E_9F543FDD193C" body="Set identification criteria, weapons control status, authorities, restrictions as geofences, delegations."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_FFCC8103_810C_0773_74C5_1E60E5574192" name="Validate and apply the plan" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_2002C302_6795_6A72_D5A5_DAFC61A96CBC" body="Validate a configuration baseline; apply it with audit."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_A7946ABB_F87A_B9BE_8EC0_92824461D120" name="Rehearse" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_902D0A39_7901_0490_C07E_E718C6002163" body="Replay a scenario through the pipeline under a plan; review recommendations and gaps."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_6B126FEF_FB76_8227_40B8_14C191FCDB0A" name="Review after action" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_826C26EE_A9AA_02AA_3C3C_A4F5C1392B2C" body="Review the journal, measure, record lessons."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_FC4CB537_CED0_BC2B_0398_77BDB68608D4" name="Operate disconnected" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_822688D1_3A93_3E11_7EED_6032A920106B" body="Fall back to embedded services; keep journaling; queue for forwarding; act under pre-delegated authority."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_804C2B18_2899_B2F2_82D1_AA5BD71376BC" name="Reconcile journals" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_CA371B80_6156_7397_A8A2_F34A6A1545F6" body="Forward the queue; merge local and node journals; report conflicts."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_9E83E20A_9924_D248_FF76_440D247959B2" name="Resolve conflicts" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_BB74C986_7E42_C681_11B5_6E43889E15B3" body="Resolve reported decision conflicts under the arbitration rule; update the record."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_1996C77A_4061_E31F_1E2B_0E01250DD6C4" name="Recommend a fires task" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_6D56368B_6043_0943_DEDC_8D72F949507E" body="Propose a fires task with target location and uncertainty, time window, and deconfliction."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_DD66F491_88F9_524A_13B4_5BB564CC8FA1" name="Manage the decision queue" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_435B0D40_C83A_7B07_E786_32024899425B" body="Order pending decisions by priority and time remaining; apply delegation; escalate; time out."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_EBD0E810_F063_088C_4D61_386E0CE18893" name="Assist with questions and drafts" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_FF30B49A_AD18_689B_F97A_67190BA5D367" body="Answer questions about the picture and draft products with provenance and no authority."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_AF84EC7F_925B_51C6_494E_02C8F3D45273" name="Govern algorithm and model baselines" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_7B422E92_104F_DF54_10DC_FAE7A9AD6699" body="Validate, promote, and roll back the algorithm and model configuration in force."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_A482A9BB_A504_3CCE_8018_679FBD5BC078" name="Authenticate and authorize" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_33DDE3F9_CA58_7D80_2034_50ABA2619FAD" body="Establish who a caller is and what their role permits before any action."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_2261B717_F6F1_6B28_1D84_70BAB7205447" name="Audit" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_7DE883FB_5849_114F_7A60_D3F13ED8E064" body="Record every decision, configuration change, promotion, tasking, and assistant exchange append-only."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="EAID_36B57685_9463_88E9_A672_90C686A4DCE5" name="Exchange cooperative identity" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="EAID_C3641DF8_E278_12E3_8BC0_3F8E603711B2" body="Receive IFF, ADS-B, AIS, and blue-force identity and attach it as evidence."/>
        </packagedElement>
      </packagedElement>
      <packagedElement xmi:type="uml:Package" xmi:id="EAPK_C28BC5E6_431E_003B_2A45_085E49D96456" name="Information Structure If-Sr" visibility="public">
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_83BC5A4A_56F9_2ECD_716C_7DEA1FFA9436" name="DetectionView" visibility="public">
          <ownedComment xmi:id="EAID_7E111C45_D39E_2661_DAE4_EF38D9DBB400" body="The canonical observation after validation; sensor, source time, receipt time, ENU measurement, provenance."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_9C0DA999_3AF6_A061_31D0_FA3F4A819831" name="TrackView" visibility="public">
          <ownedComment xmi:id="EAID_51DB4F93_95DC_D2C1_42E5_0FFBEB0570A5" body="The canonical track; state, covariance, classification, provenance, quality, mission time."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_A6A6F8DF_E482_9676_D80F_ABED1D882165" name="ResourceView" visibility="public">
          <ownedComment xmi:id="EAID_B8930901_204F_B149_1C8A_666A5C0F1935" body="A taskable resource; position, capacity, readiness."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_BD9FADF5_0061_8590_91CE_27B7D68C72B9" name="PlanView" visibility="public">
          <ownedComment xmi:id="EAID_6D132063_796D_7B6C_7071_8F88FB230BBC" body="The intercept service's recommendation; solutions and policy value."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_AAE1CA4D_EAF9_3B59_732D_D8D79E1DF835" name="InterceptSolutionView" visibility="public">
          <ownedComment xmi:id="EAID_87B7C5C0_A439_CAD8_9AC8_61716063E04E" body="One resource-to-track pairing with intercept point and time (None until the solver exists)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_75A4FB51_A839_4D6B_0629_0AF433AF9665" name="SystemHealth" visibility="public">
          <ownedComment xmi:id="EAID_037D7322_3C59_EADC_78E3_7824F7AF5DA4" body="Tracking, intercept, and ingest health flags as reported, never inferred."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_25333D8F_10A3_4B65_5CC4_54C60CBBD915" name="Provenance" visibility="public">
          <ownedComment xmi:id="EAID_0E72A140_DA89_0184_878F_46BC7C8BD5C5" body="Source sensors, calibration baseline, algorithm version."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_B7F5D203_7F60_08AD_2959_54632D9F1AF2" name="Quality" visibility="public">
          <ownedComment xmi:id="EAID_488B1043_5842_3265_C86E_F12A0DC20272" body="Association confidence, latency, staleness."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_E8A1D63D_4A4B_C22C_5045_02DF182001E0" name="Classification" visibility="public">
          <ownedComment xmi:id="EAID_F36C8DEF_0798_0440_9299_FB09DBC4834D" body="Unknown, Neutral, Friendly, Hostile."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_32038E18_120A_3E05_4202_D23E4F019C1E" name="MissionTime" visibility="public">
          <ownedComment xmi:id="EAID_7BA044A6_07C7_B7D9_0416_57BA957387BF" body="Seconds on the mission clock."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_BC5F0810_E94B_93F4_50FF_21675D7B792E" name="GlobalEntityId" visibility="public">
          <ownedComment xmi:id="EAID_587F12B0_E724_AA59_1E5D_DA3572D332C4" body="Persistent identity across sessions (u128; uuid v7 under GAP-069)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_2D5E970C_2BA4_32CA_5944_FEFB7034D052" name="Envelope" visibility="public">
          <ownedComment xmi:id="EAID_2AA22784_4A17_665D_3468_773ECFEBFA89" body="Sequence number, mission time, and one Event; the unit the bus carries and the journal stores."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_4D51ADB8_2E61_ABC8_9A74_BDFA1E911AD6" name="TrackingEvent" visibility="public">
          <ownedComment xmi:id="EAID_ED5DBF9D_7F42_76B4_7172_AF15204FCC48" body="TrackInitiated, TrackUpdated, TrackCoasting, TrackDeleted."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_D17990FE_37CA_EA90_7482_0DD67D07CCD9" name="InterceptEvent" visibility="public">
          <ownedComment xmi:id="EAID_C8E4F81A_F1D2_4DC9_3E85_5DE0B8CE3999" body="PlanProposed, PlanApproved, PlanSuperseded."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_7BB84A8B_ADA4_B8C9_3859_3D5B4C6C4F1B" name="IngestEvent" visibility="public">
          <ownedComment xmi:id="EAID_6934F1C3_6761_26B3_1F17_61915B7DB6B1" body="Accepted or Quarantined with reason."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_C92D2282_7D7D_4DB8_4729_11218FACB830" name="CommandEvent" visibility="public">
          <ownedComment xmi:id="EAID_98E4E341_7C02_7084_B08A_47D507F66C45" body="ApprovalRequested; Decided with plan, accepted, operator."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_0CCFAD02_475F_0472_7C99_DE038497BD90" name="ConfigBaseline" visibility="public">
          <ownedComment xmi:id="EAID_6F258074_028D_0A65_D24F_CB378624D064" body="Versioned, validated configuration; sensors, resources, tracking, backend, node, horizon, data directory."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_A2A1EF5E_4974_CC03_3A1D_4575514E214A" name="DecisionRecord" visibility="public">
          <ownedComment xmi:id="EAID_D7063F1A_BDA7_0C9C_4392_5E53C97C6E18" body="Who decided what on which plan, with verdict and time."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_AB3DB8EC_D1CD_AFD4_BBF8_3A00B584C9B1" name="PolicyVerdict" visibility="public">
          <ownedComment xmi:id="EAID_708B1F46_FBAB_95F1_F755_7BF03D3B4BBE" body="Approved (never by built-in engines), Denied with reason, RequiresHumanApproval."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_26E23F37_07E7_672A_7F2F_9A8F81F70C24" name="AuditEntry" visibility="public">
          <ownedComment xmi:id="EAID_751A92FF_5605_DF44_EB75_A5A73BA57317" body="Actor, action, time, outcome; append-only."/>
        </packagedElement>
