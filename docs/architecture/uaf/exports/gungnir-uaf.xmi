      <packagedElement xmi:type="uml:Package" xmi:id="EAPK_95514A5C_89FD_8F31_86F8_CF631330FE43" name="Resource Connectivity Rs-Cn" visibility="public">
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_F3B5AE02_2587_6C3B_2F1B_8B6B317D2098" name="gungnir-allocation" visibility="public">
          <ownedComment xmi:id="EAID_7D74DB4C_0D3A_DA36_9715_8CE378F90A96" body="Bellman/DP resource-to-track assignment."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_C71EB8D7_9575_6AC2_40D6_CC3AEE1F62C9" name="gungnir-analytics" visibility="public">
          <ownedComment xmi:id="EAID_DECF6A3D_2364_C71E_C3AF_A617C924F0C3" body="Advanced 3D analytical functions -- line-of-sight, viewshed, sensor-coverage volumes, terrain masking, route deconfliction -- as standalone CPU services rendered by gungnir-viewport3d rather than embedded in it. docs/gungnir-capabilities.md §5.3 -- Medium."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_B0ECAA76_C33F_26B2_B40A_5CB8386B0991" name="gungnir-api" visibility="public">
          <ownedComment xmi:id="EAID_1AD33057_BD6F_4E89_2C38_332562F72FD9" body="Versioned, security-gated external contract (v1: snapshot, event stream, detection submit, plan decision) so remote desktops, peer C2 systems, analytics tools, or enterprise data services can integrate with a service node. Transport-neutral types here; the HTTP/JSON + WebSocket transport is the next stack addition. docs/gungnir-capabilities.md §5.5 -- High."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_981BAD01_3539_D15A_0577_759B094F4517" name="gungnir-app" visibility="public">
          <ownedComment xmi:id="EAID_338881A5_F5DF_AD7E_85C0_07478F2714F4" body="eframe desktop binary: bootstrap + AppState + update loop. The one crate allowed to depend on everything. Intentionally thin -- wiring, not logic, per rust-ui-architecture-coding-standards.md §1. Selects the embedded or remote services backend from gungnir-config (ARCHITECTURE.md §8) and runs eframe with Renderer::Glow so three-d has a GL context."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_579E05F4_F770_4CBB_4E7E_F7E12258EEAF" name="gungnir-assessment" visibility="public">
          <ownedComment xmi:id="EAID_4E96F1A2_2ED2_A3E6_F364_32E154A03FA0" body="Threat/risk scoring, predicted time-to-impact, asset exposure, confidence-aware prioritization feeding the allocation decision's reward matrix. docs/gungnir-capabilities.md §5.4 -- Medium."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_C7E422EF_9DB4_4AF5_4446_EE9EB339F849" name="gungnir-association" visibility="public">
          <ownedComment xmi:id="EAID_0BFED259_5042_1354_A51D_497173745946" body="NN/GNN, Hungarian/JV, gating, JPDA, MHT."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_E3BCA50A_8AAF_9FD6_E59A_97B961A09D30" name="gungnir-collab" visibility="public">
          <ownedComment xmi:id="EAID_A2CC2979_2A11_5EC1_2875_A539A025B6BA" body="Collaboration &amp; multi-user concurrency: shared operational picture across desktops connected to one node, concurrent annotations, and authority conflict resolution between operators' decisions. docs/gungnir-capabilities.md §5.6 -- Medium. Server-authoritative mission state lives on the node (ARCHITECTURE.md §8)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_E57273C7_29DB_341C_D57B_75199AD4007C" name="gungnir-command" visibility="public">
          <ownedComment xmi:id="EAID_F4470BE8_0C52_4316_8774_0BA3D3682150" body="Human-approval workflow sitting on top of gungnir-policy's verdicts -- the operator-facing accept/override/reject boundary for an intercept plan, with every decision recorded. docs/gungnir-capabilities.md §5.4 -- Critical. Human-owned changes. Pairs with gungnir-policy."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_A877A43E_E3CD_4ACC_8C52_99B6FC35A6A2" name="gungnir-config" visibility="public">
          <ownedComment xmi:id="EAID_57DC7A90_B88A_27EC_47F2_8D4C12499B04" body="Managed, versioned, validated configuration for sensor definitions, filter/association selection, thresholds, allocation weights, backend selection (embedded or remote), and service-node settings. docs/gungnir-capabilities.md §5.1 -- High. Pairs with gungnir-mission."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_950096F4_D3BA_89B3_F1C9_CFB0F38AC3C0" name="gungnir-coord" visibility="public">
          <ownedComment xmi:id="EAID_CB1F313D_E5EE_9B65_0B1E_88F85F0FF10D" body="ECEF/ENU/NED/geodetic coordinate frame transforms."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_2D226BEB_B7EA_8A30_3699_DBD39A8EAD32" name="gungnir-core" visibility="public">
          <ownedComment xmi:id="EAID_01E124B6_40F1_1AD3_1BC1_DB3280F97E9B" body="CV/CA/CT motion models -- F/Q generation (exact-match closed-form oracle only) -- plus the identifier, lifecycle-status, and PSD-assertion primitives every higher crate shares (docs/agentic-coding-standards.md §1.2, §2.1)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_4F8C01E0_A971_0531_5A32_159B13F254E1" name="gungnir-data-fusion" visibility="public">
          <ownedComment xmi:id="EAID_53A0F62D_96BB_77D1_3D20_0C89BEB5A62D" body="GPU-accelerated point cloud registration/fusion (point-to-plane ICP) on wgpu compute, per rust-3d-data-ecosystem-build-vs-adopt.md §3. The one genuine ecosystem gap identified -- kept as its own crate, separate from gungnir-data, because it's the only data-layer crate that needs a wgpu::Device (borrowed from gungnir-render)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_F661054A_293F_C477_A44E_5548BD44913D" name="gungnir-data" visibility="public">
          <ownedComment xmi:id="EAID_4257D044_B383_87C3_048E_90AFB66C98DC" body="File I/O for point cloud / VTK scientific mesh / terrain / glTF, per rust-3d-data-ecosystem-build-vs-adopt.md §1. No egui/three-d/wgpu dependency -- unit-testable with plain cargo test."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_28539839_1B24_C5DC_3747_B63085FB0E96" name="gungnir-decision" visibility="public">
          <ownedComment xmi:id="EAID_5422BE39_0DBE_D794_7519_02EDBBBE6191" body="Course-of-action generation and comparison, constraint handling, what-if simulation against a live snapshot, and recommendation explanations -- beyond single-solution DP allocation. docs/gungnir-capabilities.md §5.4 -- Medium."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_CB511B07_8F03_396F_2AD7_BF00C8B987B1" name="gungnir-eventing" visibility="public">
          <ownedComment xmi:id="EAID_730C0421_9568_221B_E172_136F3CE445BF" body="Transport-neutral broadcast event bus (in-process today; a durable/replayable log or network stream behind the same trait later). docs/gungnir-capabilities.md §5.1 -- High. Replaces the UI polling a mutable slice every frame."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_122315A2_E25C_0289_C1DA_20C1279FC7B0" name="gungnir-filters" visibility="public">
          <ownedComment xmi:id="EAID_A08F11A0_D348_7607_B146_BD3F215CB70B" body="KF/EKF/UKF/PF/IMM/sqrt-UDU/RTS state estimation."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_7B8D4579_AE41_8060_E81C_A0998C294F42" name="gungnir-fusion-async" visibility="public">
          <ownedComment xmi:id="EAID_24720A5E_61E4_0DC9_EBBE_B0B643C1F612" body="OOS handling / multi-rate async fusion pipeline. The only crate that uses the tokio runtime; the runtime is owned by the host binary."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_E2B4F078_406F_45F3_8879_376DF93ED40F" name="gungnir-fuzz" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_91180E98_051F_2A7A_7252_FCC2461ADCDE" name="gungnir-geo" visibility="public">
          <ownedComment xmi:id="EAID_9DCB4818_0F8C_D43E_368C_27E2F25630BB" body="Coordinate-reference-system governance, map/imagery layers, geocoding, vector features, spatial indexing, and geofencing. docs/gungnir-capabilities.md §5.3 -- Medium."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_BE710630_FF76_68DA_BD58_449E091D76BD" name="gungnir-identification" visibility="public">
          <ownedComment xmi:id="EAID_14F3E7E8_17B6_4F33_FC1E_60F9C7BFB279" body="Friend/foe/unknown track classification from an evidence-fusion process. gungnir-capabilities.md §5.3 -- Medium."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_57EA2B16_5863_BDE5_13F4_DB46A5F3652B" name="gungnir-identity" visibility="public">
          <ownedComment xmi:id="EAID_50B5AA80_1F13_58AE_3EC6_971E5F60A54A" body="Persistent global track/entity identity across feeds -- aliases, merge/split history, supersession -- beyond the tracking core's internal track IDs. docs/gungnir-capabilities.md §5.3 -- High."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_D2DCDE6F_804C_2A4D_2999_5A9935CE0597" name="gungnir-ingest" visibility="public">
          <ownedComment xmi:id="EAID_06DA865F_DE40_472C_47A0_18147B045752" body="Protocol-specific adapters plus a validation/authentication/quarantine gateway that normalizes live, recorded, and simulated sources into the canonical DetectionView before anything reaches the Tracking Service. docs/gungnir-capabilities.md §5.2 -- Critical. Gateway changes are human-owned."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_E0CF00EC_F981_B047_F636_22FC66A1F564" name="gungnir-intercept-service" visibility="public">
          <ownedComment xmi:id="EAID_C81B70BF_027F_D83B_3FE4_5E1B0AA64E6F" body="App-facing facade over gungnir-allocation + gungnir-coord: turns current tracks + available resources into an intercept/tasking plan (gungnir-model PlanView). Kept separate from gungnir-tracking-service because it answers 'what should we do' rather than 'where are they' -- see ARCHITECTURE.md §2."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_6E07FC01_1A44_E74E_D435_5AF71F2D24EC" name="gungnir-interop" visibility="public">
          <ownedComment xmi:id="EAID_CE39E0C6_B3CD_0CB1_0A4D_6AD11C75EBC6" body="Data standards &amp; interoperability: the schema catalog with version negotiation, the Arrow representation of detections, and the ASTERIX/STANAG codec boundary that gungnir-ingest adapters and gungnir-reporting exports use. docs/gungnir-capabilities.md §5.6 and §1 (interop schema row) -- Medium."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_C9E22673_BF68_0E1C_9563_7CC663DD2546" name="gungnir-metrics" visibility="public">
          <ownedComment xmi:id="EAID_59AAB961_4EE6_B9E7_7DFE_BF67EFF2D553" body="MOTA/MOTP, purity/fragmentation, track-to-truth assignment."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_8F2DAF18_AAE1_F682_6DEC_07AC1AFF46E1" name="gungnir-mission" visibility="public">
          <ownedComment xmi:id="EAID_EB31CBBD_76DA_277B_486E_2101BC9519C1" body="Mission/session lifecycle: create/load/save/replay/close, plus scenario binding. gungnir-capabilities.md §5.1 -- High. Pairs with gungnir-config."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_D9431BBC_CD21_9DAB_ADE5_D8447EEEBCBA" name="gungnir-ml" visibility="public">
          <ownedComment xmi:id="EAID_281C1881_A2BE_67B3_02F1_E708A5AF7308" body="The model and feature-extractor traits learned models are held to, a fake model for the consumers' tests, and the dataset extraction from test-track sets into the Arrow form docs/ml/data-pipeline.md documents (GAP-077, GAP-079). OnnxModel, the ort-backed real Model, is real compiling code behind the onnx-runtime feature (off by default: agentic-coding-standards.md §2.9, D-40) -- ort 2.0.0-rc.13's load-dynamic path panics rather than erroring when no compatible ONNX Runtime library is reachable, so it must not run inside default `cargo test`. ModelSet::load reports which named models are unavailable rather than pretending."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_64E4DD7A_29F0_3638_5F94_836FFD1A5412" name="gungnir-model" visibility="public">
          <ownedComment xmi:id="EAID_5F748CD6_5431_F24B_3A6F_FCACA3D83AD1" body="Canonical, versioned operational data model -- TrackView/DetectionView/ResourceView/PlanView and friends, with provenance, quality, identity, timestamps, and classification as first-class fields. Foundational/Critical per docs/gungnir-capabilities.md §5.1 -- the service facades and every productization crate build on this one."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_EFEF1E6D_A2EB_2A0A_1575_C0C3B150A95C" name="gungnir-modelops" visibility="public">
          <ownedComment xmi:id="EAID_58B4152A_39C9_A580_2E29_87F466604996" body="Registry for selecting, tuning, comparing, validating, promoting, and rolling back filter/association configurations by mission profile, and (GAP-078) the model artefact -- name, version, hash, evaluation record -- a baseline optionally carries alongside its tracking configuration through the same promotion state machine. gungnir-capabilities.md §5.4 -- Medium."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_B54E6A0F_2EFB_4712_34F9_849E60423D11" name="gungnir-node" visibility="public">
          <ownedComment xmi:id="EAID_63BE092D_585E_7CDE_69FE_F0BA35BDDAB2" body="Headless service-node binary for the on-prem and cloud profiles (ARCHITECTURE.md §8.1): hosts the services layer and the authoritative gungnir-store journal behind gungnir-api. Targets Linux x86_64 containers; depends on no UI, three-d, or wgpu crate."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_5D7CDC20_986E_A5AA_04B8_C3A25EE80A66" name="gungnir-observability" visibility="public">
          <ownedComment xmi:id="EAID_5ADFAF99_32F5_E61E_547B_BA509C153222" body="Production-facing metrics, structured logs, distributed traces, health checks, watchdogs, and alert correlation -- extends the developer-facing tracing instrumentation into an operator-facing system-status capability. gungnir-capabilities.md §5.5 -- High."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_48FBCF16_5B1C_7BC0_23D5_0CB9803874A5" name="gungnir-oracle" visibility="public">
          <ownedComment xmi:id="EAID_6DAB556A_88A3_DBC0_53AE_94B1FAAF3B20" body="Differential-test harness against Python/MATLAB oracles. Depends on everything; nothing depends on it."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_BFA9ABA7_E0B2_F6D4_DE9E_6521631700AB" name="gungnir-policy" visibility="public">
          <ownedComment xmi:id="EAID_B4112128_740A_68D6_03CC_3B50BC6156B5" body="Authority model, geofence/no-go enforcement, and policy evaluation sitting in front of the Intercept Planning Service's output. docs/gungnir-capabilities.md §5.4 -- Critical. Human-owned changes (agentic-workflow.md). Pairs with gungnir-command."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_F601648C_5348_BCE0_CC7F_F90793A8073B" name="gungnir-remote" visibility="public">
          <ownedComment xmi:id="EAID_41A07F2D_78F2_0DBD_E332_B4B43AEA246F" body="Remote implementations of the TrackingService and InterceptService traits that talk to a gungnir-node over gungnir-api, so the desktop switches between the embedded and connected profiles without any UI change (ARCHITECTURE.md §8.2). Store-and-forward while disconnected."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_37E76131_E239_A3A3_B18D_F58B02CC6E6C" name="gungnir-render" visibility="public">
          <ownedComment xmi:id="EAID_856F4A2C_D770_3D10_EB4D_574D81CF15E9" body="Shared wgpu device/queue/surface management + egui&lt;-&gt;wgpu render pass wiring, per rust-ui-architecture-coding-standards.md §1. No tracking-domain knowledge."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_7880001A_ECAB_99D1_8294_F7603960B8BC" name="gungnir-replay" visibility="public">
          <ownedComment xmi:id="EAID_74787076_E13C_E3FF_99E7_83DFC4E09D8F" body="Deterministic session playback, timeline scrubbing, and recorded-data replay -- reads gungnir-store's event journal through a gungnir-time ReplayClockAuthority. docs/gungnir-capabilities.md §5.6 -- Lower."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_E8948346_3461_822B_798D_BEC44B8A454F" name="gungnir-reporting" visibility="public">
          <ownedComment xmi:id="EAID_236FF979_D6CE_A2B6_870D_BDBFD6D03682" body="Mission reports and export packages with provenance preserved: every figure traces back to the recorded event journal it was computed from. docs/gungnir-capabilities.md §5.6 -- Lower."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_0C13A9A9_B821_DCBE_724C_3C8318FE2714" name="gungnir-resilience" visibility="public">
          <ownedComment xmi:id="EAID_5F8CE449_6E58_EB4E_CCE9_48F92D5A0A63" body="Resilience &amp; disconnected operations: store-and-forward of envelopes while a node is unreachable, checkpoints, and journal reconciliation after the link returns (ARCHITECTURE.md §8.4). docs/gungnir-capabilities.md §5.6 -- Medium."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_6028FED4_CBC4_6029_5B92_BD13B1E3D8F7" name="gungnir-rfs" visibility="public">
          <ownedComment xmi:id="EAID_050AA97A_31BD_8159_73F1_0AE9BA16CE24" body="PHD/CPHD, GLMB/LMB random finite set filters."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_68B3A19C_3095_C295_5A93_805CA264E340" name="gungnir-scenario" visibility="public">
          <ownedComment xmi:id="EAID_57F39940_B80A_0A20_B98E_CF2277287D1B" body="Ground-truth + sensor simulation, five-scenario generator. Test/bench dependency only -- never a normal dependency of a production crate."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_1F7E59D2_91DA_67F5_35EA_69B1AA548131" name="gungnir-security" visibility="public">
          <ownedComment xmi:id="EAID_AC64A2E8_1033_4485_73CF_0A7C1D999D27" body="Authentication, role/attribute-based authorization, encryption in transit and at rest, secrets/key management, signed binaries and configuration, audit logging. gungnir-capabilities.md §5.5 -- Critical."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_13020BC4_C8F8_529E_F926_12A9790CD3E0" name="gungnir-sensor-management" visibility="public">
          <ownedComment xmi:id="EAID_B5783A89_532E_D00B_202D_B24D99A90A54" body="Sensor registry (identity, modality, location, calibration version, operating state) plus tasking, mode management, and coverage planning. docs/gungnir-capabilities.md §5.2 -- High."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_1C33C695_E991_53CA_A16D_D43DF4220FB0" name="gungnir-store" visibility="public">
          <ownedComment xmi:id="EAID_9C470B49_369B_10E5_0777_8B67A72539DE" body="Durable storage for mission sessions (an append-only JSON-lines event journal), replay artifacts, configuration baselines, and audit logs, with an explicit retention/deletion policy. docs/gungnir-capabilities.md §5.1 -- High."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_861FB812_0AA8_7F82_814D_B50A80505B57" name="gungnir-testkit" visibility="public">
          <ownedComment xmi:id="EAID_D6DDD2AA_29F1_28AF_2DE9_0C28A1D8DAF5" body="Shared proptest strategies for the tracking core. Depends on no workspace crate (so it can be a dev-dependency of every one of them without a dev-dependency cycle); nothing depends on it at runtime."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_53A0ED3C_E2C9_4106_FCA4_FC80233D1B99" name="gungnir-time" visibility="public">
          <ownedComment xmi:id="EAID_36F625A0_9378_77D1_7B35_EFCFD3AAF63D" body="Clock discipline across sensors: source-time vs. receipt-time semantics, late-data policy, deterministic replay-time control, synchronization health. docs/gungnir-capabilities.md §5.2 -- Critical."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_460AD572_1581_B53C_5ABD_3BD83C8CD3C4" name="gungnir-track-fusion" visibility="public">
          <ownedComment xmi:id="EAID_7C467C58_416A_E0D8_D70B_AC6FFD53D9BD" body="Track-to-track fusion (CI/info-matrix), sensor registration/bias."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_50626043_5067_5DFA_DD6B_5B851BF101A1" name="gungnir-track" visibility="public">
          <ownedComment xmi:id="EAID_3560FD72_B852_5ACD_DA79_DD62D7D3FAC5" body="Track lifecycle: init/confirm/coast/delete."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_66D74D04_50E4_E04A_706C_8232C5826FBF" name="gungnir-tracking-service" visibility="public">
          <ownedComment xmi:id="EAID_39FDE24C_2AD4_C474_07C5_D92FA167298D" body="App-facing facade over the tracking/estimation core. Owns the IMM bank, associator, track manager, and async multi-rate/OOS fusion pipeline behind one trait, and projects the core's kinematic Track into the canonical gungnir-model TrackView. See ARCHITECTURE.md §2."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_87625414_8638_CA09_9B17_71C7612320DE" name="gungnir-ui" visibility="public">
          <ownedComment xmi:id="EAID_A0B80F3D_19A1_FFF5_59F2_0C525E5A5E3F" body="2D egui dashboard panels + centralized theme, per rust-ui-architecture-coding-standards.md §1/§6. One file per panel; no magic layout numbers. Reads gungnir-model views only; holds no state of its own."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_86076BDF_CF53_3967_1A11_A8F025527BA0" name="gungnir-viewport3d" visibility="public">
          <ownedComment xmi:id="EAID_B7277AB1_790C_42ED_B076_D9512199211F" body="three-d scene setup, camera, streaming/scientific data bridges, and live track/intercept rendering, drawn into eframe's OpenGL (glow) context. Combines rust-3d-data-ecosystem-build-vs-adopt.md §2 with gungnir-model views -- see ARCHITECTURE.md §4-5 for why track rendering lives here rather than in a translation crate."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_8C647CED_4491_B0B6_9D46_A0791BB85611" name="gungnir-workflow" visibility="public">
          <ownedComment xmi:id="EAID_B63F1300_A663_CA54_179A_35DB17D280BF" body="Human factors &amp; operator workflow: role-based workspace layouts, the alert acknowledgement/escalation lifecycle, annotations and cases -- turning a set of panels into a designed operator workflow. docs/gungnir-capabilities.md §5.6 -- Medium."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Dependency" xmi:id="EAID_33AC7AEF_351C_FB23_1ADF_5F590C703D8A" name="uses: RS-allocation -&gt; RS-core" visibility="public" supplier="EAID_2D226BEB_B7EA_8A30_3699_DBD39A8EAD32" client="EAID_F3B5AE02_2587_6C3B_2F1B_8B6B317D2098"/>
        <packagedElement xmi:type="uml:Dependency" xmi:id="EAID_BAD516C7_2214_58C2_6C57_91365BE93280" name="uses: RS-allocation -&gt; RS-testkit" visibility="public" supplier="EAID_861FB812_0AA8_7F82_814D_B50A80505B57" client="EAID_F3B5AE02_2587_6C3B_2F1B_8B6B317D2098"/>
        <packagedElement xmi:type="uml:Dependency" xmi:id="EAID_E70F0B67_C146_8371_AF32_D17C243D0885" name="uses: RS-analytics -&gt; RS-coord" visibility="public" supplier="EAID_950096F4_D3BA_89B3_F1C9_CFB0F38AC3C0" client="EAID_C71EB8D7_9575_6AC2_40D6_CC3AEE1F62C9"/>
        <packagedElement xmi:type="uml:Dependency" xmi:id="EAID_B003D8FB_859B_D468_03CB_5EF799A695AE" name="uses: RS-analytics -&gt; RS-data" visibility="public" supplier="EAID_F661054A_293F_C477_A44E_5548BD44913D" client="EAID_C71EB8D7_9575_6AC2_40D6_CC3AEE1F62C9"/>
        <packagedElement xmi:type="uml:Dependency" xmi:id="EAID_99CC6CBD_EEAF_3E8E_82C0_1C6295CED866" name="uses: RS-analytics -&gt; RS-geo" visibility="public" supplier="EAID_91180E98_051F_2A7A_7252_FCC2461ADCDE" client="EAID_C71EB8D7_9575_6AC2_40D6_CC3AEE1F62C9"/>
        <packagedElement xmi:type="uml:Dependency" xmi:id="EAID_F6247DDB_BDED_0286_B4CD_6AFBCC2A7BE3" name="uses: RS-analytics -&gt; RS-model" visibility="public" supplier="EAID_64E4DD7A_29F0_3638_5F94_836FFD1A5412" client="EAID_C71EB8D7_9575_6AC2_40D6_CC3AEE1F62C9"/>
        <packagedElement xmi:type="uml:Dependency" xmi:id="EAID_3212FABC_EF0C_FEAD_D272_DAC63174D2C4" name="uses: RS-analytics -&gt; RS-sensor-management" visibility="public" supplier="EAID_13020BC4_C8F8_529E_F926_12A9790CD3E0" client="EAID_C71EB8D7_9575_6AC2_40D6_CC3AEE1F62C9"/>
        <packagedElement xmi:type="uml:Dependency" xmi:id="EAID_CF0F48F0_6B41_FD71_A859_CEA3D1ECEB30" name="uses: RS-analytics -&gt; RS-config" visibility="public" supplier="EAID_A877A43E_E3CD_4ACC_8C52_99B6FC35A6A2" client="EAID_C71EB8D7_9575_6AC2_40D6_CC3AEE1F62C9"/>
