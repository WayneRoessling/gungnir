        <packagedElement xmi:type="uml:Class" xmi:id="SD-08" name="TLS 1.3 (RFC 8446)" visibility="public">
          <ownedComment xmi:id="SD-08-desc" body="Encryption in transit and mutual authentication of machines (GAP-060)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SD-09" name="AIS (ITU-R M.1371)" visibility="public">
          <ownedComment xmi:id="SD-09-desc" body="Cooperative maritime identity (GAP-010)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SD-10" name="ADS-B 1090 ES (RTCA DO-260B)" visibility="public">
          <ownedComment xmi:id="SD-10-desc" body="Cooperative air identity (GAP-010)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SD-11" name="UUID version 7 (RFC 9562)" visibility="public">
          <ownedComment xmi:id="SD-11-desc" body="Textual and time-ordered form of GlobalEntityId (GAP-069)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SD-12" name="OCI container image" visibility="public">
          <ownedComment xmi:id="SD-12-desc" body="Packaging of the service node for Linux x86_64."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SD-13" name="Software bill of materials (CycloneDX JSON) and signed releases" visibility="public">
          <ownedComment xmi:id="SD-13-desc" body="Release evidence per docs/release-governance.md; exercised under GAP-061."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SD-14" name="UAF 1.2 (OMG)" visibility="public">
          <ownedComment xmi:id="SD-14-desc" body="The framework these views follow."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SD-15" name="TOGAF 10 ADM" visibility="public">
          <ownedComment xmi:id="SD-15-desc" body="The method plan 10 follows; references these views."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SD-16" name="Cursor-on-Target (CoT)" visibility="public">
          <ownedComment xmi:id="SD-16-desc" body="Exchange with a participant that holds no machine identity here; no codec and no sink exist (GAP-090, GAP-091)."/>
        </packagedElement>
    </packagedElement>
