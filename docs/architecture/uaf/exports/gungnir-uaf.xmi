        <packagedElement xmi:type="uml:Class" xmi:id="EAID_638251D7_6D95_CFCE_AD9F_8527A04E6CC5" name="Commander" visibility="public">
          <ownedComment xmi:id="EAID_1D8A329A_6839_7427_75F2_02C6C7FE0E6B" body="Holds the authorities the others act under; may decide directly."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_3241D715_19C5_0A12_92C0_41DDAFF355B0" name="Sector command post" visibility="public">
          <ownedComment xmi:id="EAID_6A1CC01D_E997_CD23_F94B_3C49C6CEB751" body="The sector's command post; hosts the service node, the supervisor, operators, sensor manager, planner, intelligence analyst (vignettes, SCP)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_2467C107_D981_B704_1348_0A70438EF432" name="Site defense cell" visibility="public">
          <ownedComment xmi:id="EAID_3203B8FC_DC34_BF02_CA1B_607BB3141E25" body="A defended site's cell with a desktop and local sensors and effectors (vignettes, OPS and HAF)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="EAID_4C934894_EF82_01D6_E7C0_84CA2445A88F" name="Port defense cell" visibility="public">
          <ownedComment xmi:id="EAID_5A655E38_51EB_B378_144F_9926D2EA41C6" body="The port's cell with a desktop, coastal sensors, patrol craft (vignettes, KAL)."/>
        </packagedElement>
