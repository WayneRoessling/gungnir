      <element xmi:idref="EAID_981BAD01_3539_D15A_0577_759B094F4517" xmi:type="uml:Class" name="gungnir-app" scope="public">
        <model package="EAPK_95514A5C_89FD_8F31_86F8_CF631330FE43" tpos="0" ea_eleType="element"/>
        <properties isSpecification="false" sType="Class" nType="0" scope="public" stereotype="ResourceArtifact" documentation="eframe desktop binary: bootstrap + AppState + update loop. The one crate allowed to depend on everything. Intentionally thin -- wiring, not logic, per rust-ui-architecture-coding-standards.md §1. Selects the embedded or remote services backend from gungnir-config (ARCHITECTURE.md §8) and runs eframe with Renderer::Glow so three-d has a GL context."/>
