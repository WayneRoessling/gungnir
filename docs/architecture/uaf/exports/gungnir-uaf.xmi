        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SD-03" name="ASTERIX Category 048 (Eurocontrol)" visibility="public">
          <ownedComment xmi:id="SD-03-desc" body="Radar target reports; codec returns NotImplemented (GAP-064)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SD-04" name="STANAG 4676 (NATO ISR tracking standard)" visibility="public">
          <ownedComment xmi:id="SD-04-desc" body="Track exchange with coalition; codec returns NotImplemented (GAP-064)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SD-05" name="JSON (RFC 8259)" visibility="public">
          <ownedComment xmi:id="SD-05-desc" body="Serialization of configuration, journal lines, and API payloads."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SD-06" name="HTTP/1.1 (RFC 9112)" visibility="public">
          <ownedComment xmi:id="SD-06-desc" body="Request and response transport for the API (GAP-041)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SD-07" name="WebSocket (RFC 6455)" visibility="public">
          <ownedComment xmi:id="SD-07-desc" body="The API event stream (GAP-041)."/>
