      <element xmi:idref="EAID_D9431BBC_CD21_9DAB_ADE5_D8447EEEBCBA" xmi:type="uml:Class" name="gungnir-ml" scope="public">
        <model package="EAPK_95514A5C_89FD_8F31_86F8_CF631330FE43" tpos="0" ea_eleType="element"/>
        <properties isSpecification="false" sType="Class" nType="0" scope="public" stereotype="ResourceArtifact" documentation="The model and feature-extractor traits learned models are held to, a fake model for the consumers' tests, and the dataset extraction from test-track sets into the Arrow form docs/ml/data-pipeline.md documents (GAP-077, GAP-079). OnnxModel, the ort-backed real Model, is real compiling code behind the onnx-runtime feature (off by default: agentic-coding-standards.md §2.9, D-40) -- ort 2.0.0-rc.13's load-dynamic path panics rather than erroring when no compatible ONNX Runtime library is reachable, so it must not run inside default `cargo test`. ModelSet::load reports which named models are unavailable rather than pretending."/>
        <project author="gungnir" version="1.0" phase="1.0" created="2026-09-04 00:00:00" modified="2026-09-04 00:00:00" complexity="1" status="Proposed"/>
        <style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
