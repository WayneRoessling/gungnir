        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-25" name="Store-and-forward and reconciliation" visibility="public">
          <ownedComment xmi:id="SV-25-desc" body="Bounded queue while disconnected; journal merge with conflict reporting."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-26" name="Shared picture and arbitration" visibility="public">
          <ownedComment xmi:id="SV-26-desc" body="Apply node envelopes to a projection; role-rank arbitration of conflicts."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-27" name="Operator workflow" visibility="public">
          <ownedComment xmi:id="SV-27-desc" body="Role workspace layouts; alert lifecycle; cases and annotations."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-28" name="Replay" visibility="public">
          <ownedComment xmi:id="SV-28-desc" body="Deterministic playback of a journal under the replay clock."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-29" name="Reporting" visibility="public">
          <ownedComment xmi:id="SV-29-desc" body="Reports and exports with every figure traceable to the journal."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-30" name="Remote backends" visibility="public">
          <ownedComment xmi:id="SV-30-desc" body="RemoteTrackingService and RemoteInterceptService over the API with an outbox; transport pending."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-31" name="Data loading" visibility="public">
          <ownedComment xmi:id="SV-31-desc" body="Point cloud, VTK, terrain, glTF loaders off the UI thread (surface only)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-32" name="Point-cloud fusion" visibility="public">
          <ownedComment xmi:id="SV-32-desc" body="CPU reference and GPU ICP registration (trait surface)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-33" name="Tracking metrics" visibility="public">
          <ownedComment xmi:id="SV-33-desc" body="MOTA, MOTP, purity, fragmentation against truth."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="SV-34" name="Scenario generation" visibility="public">
          <ownedComment xmi:id="SV-34-desc" body="The five engineering scenarios with truth."/>
        </packagedElement>
    </packagedElement>
