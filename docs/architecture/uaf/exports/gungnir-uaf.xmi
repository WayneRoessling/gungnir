        <packagedElement xmi:type="uml:Class" xmi:id="SV-21" name="Authorization" visibility="public">
          <ownedComment xmi:id="SV-21-desc" body="Role-to-action matrix; unknown operators permitted nothing."/>
        </packagedElement>
