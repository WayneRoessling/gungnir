<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmlns:uml="http://schema.omg.org/spec/UML/2.1" xmlns:EAUML="http://www.sparxsystems.com/profiles/EAUML/1.0" xmlns:UAF="http://www.omg.org/spec/UAF/20160505/UAF">
  <uml:Model xmi:type="uml:Model" xmi:id="MODEL-gungnir-uaf" name="Gungnir UAF Model">
    <packagedElement xmi:type="uml:Package" xmi:id="PKG-St-Tx" name="Strategic Taxonomy St-Tx">
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-1" name="Sense" visibility="public">
          <ownedComment xmi:id="CAP-1-desc" body="Bring every observation the sector can obtain into one governed, time-disciplined stream."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-1.1" name="Ingest observations from every sensor class" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-1.2" name="Validate, authenticate, and quarantine input" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-1.3" name="Manage sensor readiness, modes, tasking, and calibration" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-1.4" name="Know sensor coverage and gaps over terrain" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-1.5" name="Keep time discipline" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-1.6" name="Receive early warning, tracks, and reports from peers" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-1.7" name="Receive cooperative identity" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-2" name="Understand" visibility="public">
          <ownedComment xmi:id="CAP-2-desc" body="Turn observations into one honest picture with identities, uncertainty, and context."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-2.1" name="Maintain one multi-sensor track picture with uncertainty" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-2.2" name="Keep tracks through gaps with visible quality" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-2.3" name="Register sensors against each other" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-2.4" name="Track dense groups and count targets" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-2.5" name="Maintain a clutter-tolerant surface picture" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-2.6" name="Classify and identify with evidence and confidence" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-2.7" name="Keep one identity across gaps, sorties, sessions, and peers" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-2.8" name="Predict trajectory, time to impact, closest approach" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-2.9" name="Detect anomalies in tracks and feeds" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-2.10" name="Fuse terrain, imagery, point clouds, and map layers" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-2.11" name="Answer geometric questions" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-2.12" name="Maintain pattern of life and order of battle" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-3" name="Decide" visibility="public">
          <ownedComment xmi:id="CAP-3-desc" body="Turn the picture into a policy-checked recommendation for a human."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-3.1" name="Maintain the defended-asset list" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-3.2" name="Score threat and priority per track" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-3.3" name="Recommend the cheapest adequate assignment" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-3.4" name="Compute intercept geometry" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-3.5" name="Offer alternatives, what-if, and rationale" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-3.6" name="Enforce rules of engagement" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-3.7" name="Manage the queue under saturation" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-3.8" name="Recommend fires tasks with deconfliction" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-3.9" name="Recommend sensor re-tasking under degradation" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-4" name="Act (recommend and authorize)" visibility="public">
          <ownedComment xmi:id="CAP-4-desc" body="Put the recommendation in front of the person who holds authority, record what they decide, and hand off; never act without that record."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-4.1" name="Present recommendations for decision" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-4.2" name="Record every decision" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-4.3" name="Never execute without a recorded human decision" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-4.4" name="Hand off to effector systems with provenance" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-4.5" name="Warn assets and authorities" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-4.6" name="Track engagements and assess effects" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-4.7" name="Assist roles without authority" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-5" name="Sustain" visibility="public">
          <ownedComment xmi:id="CAP-5-desc" body="Keep the sector operating, learning, and honest over time and through outages."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-5.1" name="Journal every event durably" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-5.2" name="Replay and rehearse" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-5.3" name="Produce reports and measures from the journal" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-5.4" name="Operate disconnected and reconcile" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-5.5" name="Report health honestly and run the alert lifecycle" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-5.6" name="Manage configuration baselines and mission plans" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-5.7" name="Govern algorithm and model baselines" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-5.8" name="Support the battle rhythm" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-5.9" name="Provide role-based workspaces and workflow" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-5.10" name="Meet performance budgets per profile" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-6" name="Secure" visibility="public">
          <ownedComment xmi:id="CAP-6-desc" body="Control who can see and do what, and prove it afterwards."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-6.1" name="Authenticate operators and callers" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-6.2" name="Authorize by role, class, and layer" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-6.3" name="Audit everything that matters" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-6.4" name="Protect data in transit and at rest" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-6.5" name="Assure the supply chain" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-6.6" name="Mark and enforce releasability" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-6.7" name="Treat external input as untrusted" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-7" name="Integrate" visibility="public">
          <ownedComment xmi:id="CAP-7-desc" body="Be one node in a system of systems."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-7.1" name="Expose a versioned interface" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-7.2" name="Speak the domain's interoperability standards" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-7.3" name="Run as desktop, on-prem node, or cloud node" visibility="public">
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="CAP-7.4" name="Exchange with peers and coalition" visibility="public">
        </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="PKG-Op-Sr" name="Operational Structure Op-Sr">
        <packagedElement xmi:type="uml:Class" xmi:id="OP-01" name="Operator" visibility="public">
          <ownedComment xmi:id="OP-01-desc" body="Runs the live picture for a domain at a site or the sector; decides engagements within delegated authority."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="OP-02" name="Supervisor" visibility="public">
          <ownedComment xmi:id="OP-02-desc" body="Runs the sector; manages the recommendation queue, weapons control status, holds, degraded-state acknowledgement, reconciliation conflicts, plan apply."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="OP-03" name="Analyst" visibility="public">
          <ownedComment xmi:id="OP-03-desc" body="Works the recorded record; replay, after-action review, reports, measures, model promotion evidence."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="OP-04" name="Sensor manager" visibility="public">
          <ownedComment xmi:id="OP-04-desc" body="Owns sensor readiness, modes, coverage, tasking, and calibration."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="OP-05" name="Administrator" visibility="public">
          <ownedComment xmi:id="OP-05-desc" body="Owns configuration baselines, accounts and roles, the node, and the audit record."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="OP-06" name="Intelligence analyst" visibility="public">
          <ownedComment xmi:id="OP-06-desc" body="Owns requirements and tasking, identification evidence and declarations, order of battle, pattern of life, dissemination."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="OP-07" name="Planner" visibility="public">
          <ownedComment xmi:id="OP-07-desc" body="Owns defended-asset list drafts, laydown and coverage planning, mission plans, rehearsal."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="OP-08" name="Commander" visibility="public">
          <ownedComment xmi:id="OP-08-desc" body="Holds the authorities the others act under; may decide directly."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="OP-10" name="Sector command post" visibility="public">
          <ownedComment xmi:id="OP-10-desc" body="The sector's command post; hosts the service node, the supervisor, operators, sensor manager, planner, intelligence analyst (vignettes, SCP)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="OP-11" name="Site defense cell" visibility="public">
          <ownedComment xmi:id="OP-11-desc" body="A defended site's cell with a desktop and local sensors and effectors (vignettes, OPS and HAF)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="OP-12" name="Port defense cell" visibility="public">
          <ownedComment xmi:id="OP-12-desc" body="The port's cell with a desktop, coastal sensors, patrol craft (vignettes, KAL)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="OP-20" name="Higher command" visibility="public">
          <ownedComment xmi:id="OP-20-desc" body="Sets rules of engagement; receives status, warnings, reports, order of battle."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="OP-21" name="Neighbouring sector" visibility="public">
          <ownedComment xmi:id="OP-21-desc" body="Exchanges tracks and warnings; hands over raids."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="OP-22" name="Fire units and effector systems" visibility="public">
          <ownedComment xmi:id="OP-22-desc" body="Receive decided assignments; report readiness and outcomes."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="OP-23" name="Sensor operators and maintainers" visibility="public">
          <ownedComment xmi:id="OP-23-desc" body="Operate and maintain sensors; modes, faults, calibration."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="OP-24" name="Civil aviation authority and airport" visibility="public">
          <ownedComment xmi:id="OP-24-desc" body="Corridors, flight plans, ADS-B; receive warnings of engagements."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="OP-25" name="Port and maritime authorities" visibility="public">
          <ownedComment xmi:id="OP-25-desc" body="AIS, harbour operations, barriers; receive warnings."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="OP-26" name="Coalition partners" visibility="public">
          <ownedComment xmi:id="OP-26-desc" body="Picture and product exchange with releasability."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="OP-27" name="Accreditors and auditors" visibility="public">
          <ownedComment xmi:id="OP-27-desc" body="Need evidence that the system enforces policy and records decisions."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="OP-30" name="Command-and-control system (Gungnir)" visibility="public">
          <ownedComment xmi:id="OP-30-desc" body="The logical performer that exhibits every system capability; realized by the desktop and the service node."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="OP-31" name="Operator workstation" visibility="public">
          <ownedComment xmi:id="OP-31-desc" body="The desktop (gungnir-app) with embedded or remote services."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="OP-32" name="Sector service node" visibility="public">
          <ownedComment xmi:id="OP-32-desc" body="The headless node (gungnir-node) that is the system of record in connected profiles."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="OP-33" name="Sensor network" visibility="public">
          <ownedComment xmi:id="OP-33-desc" body="The sensors feeding the sector, logically part of the C2 system's inputs; physical sensors are actual resources."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="OP-34" name="Effector interface" visibility="public">
          <ownedComment xmi:id="OP-34-desc" body="The handoff boundary to fire units and effector systems (CAP-4.4)."/>
        </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="PKG-Op-Pr" name="Operational Processes Op-Pr">
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-01" name="Ingest and validate observations" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-01-desc" body="Bring sensor, cooperative, peer, and human reports in; validate; quarantine; carry provenance."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-02" name="Maintain the track picture" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-02-desc" body="Initiate, update, coast, and delete tracks from all sources with uncertainty and quality."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-03" name="Identify tracks" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-03-desc" body="Classify and identify from kinematic, signature, cooperative, and human evidence with stated confidence."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-04" name="Assess threat and priority" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-04-desc" body="Predict path, asset threatened, time to impact, closest approach; score against the defended-asset list."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-05" name="Recommend assignments" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-05-desc" body="Propose the cheapest adequate resource-to-track assignment within readiness, geometry, and policy."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-06" name="Check policy" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-06-desc" body="Evaluate identification criteria, weapons control status, authority, geofences, and restrictions; produce a verdict."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-07" name="Decide" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-07-desc" body="A human accepts, overrides, rejects, holds, or lets expire; the decision is recorded."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-08" name="Hand off to effectors" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-08-desc" body="Pass decided assignments to fire units and effector systems with provenance."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-09" name="Warn assets and authorities" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-09-desc" body="Warn defended assets, units, and civil authorities with lead time; record the warning."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-10" name="Assess engagement effects" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-10-desc" body="Track the engaged threat, record the outcome, supersede plans, re-plan the remainder."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-11" name="Journal and report" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-11-desc" body="Journal every event; produce summaries, reports, and measures after action."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-12" name="Manage sensors and coverage" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-12-desc" body="Set modes, task sensors, keep calibration, compute coverage and gaps over terrain."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-13" name="Detect and correlate degradation" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-13-desc" body="Detect sensor loss, ingest gaps, clock skew, quality collapse; correlate into incidents."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-14" name="Re-task sensors" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-14-desc" body="Change modes and tasking to restore the most valuable coverage; show before and after."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-15" name="Exchange the picture with peers" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-15-desc" body="Send and receive tracks, warnings, and products with peers, higher command, and partners."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-16" name="Flag anomalies" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-16-desc" body="Detect AIS-off, spoofing, loitering, and implausible feeds as alerts through the lifecycle."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-17" name="State collection requirements" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-17-desc" body="Express an information requirement with area, question, priority, and window; task or decline it."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-18" name="Fuse identification evidence" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-18-desc" body="Combine evidence into identities with confidence; retain the evidence with the track."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-19" name="Maintain entities and order of battle" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-19-desc" body="Keep global identities across sessions; merge and split; accumulate pattern of life."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-20" name="Disseminate products" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-20-desc" body="Release identities, warnings, and products to roles and peers with marking."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-21" name="Set the defended-asset list and priorities" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-21-desc" body="Define protected assets, priorities, and warning obligations."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-22" name="Plan the laydown" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-22-desc" body="Place sensors and effectors; compute coverage and gaps over terrain."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-23" name="Configure policy" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-23-desc" body="Set identification criteria, weapons control status, authorities, restrictions as geofences, delegations."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-24" name="Validate and apply the plan" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-24-desc" body="Validate a configuration baseline; apply it with audit."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-25" name="Rehearse" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-25-desc" body="Replay a scenario through the pipeline under a plan; review recommendations and gaps."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-26" name="Review after action" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-26-desc" body="Review the journal, measure, record lessons."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-27" name="Operate disconnected" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-27-desc" body="Fall back to embedded services; keep journaling; queue for forwarding; act under pre-delegated authority."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-28" name="Reconcile journals" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-28-desc" body="Forward the queue; merge local and node journals; report conflicts."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-29" name="Resolve conflicts" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-29-desc" body="Resolve reported decision conflicts under the arbitration rule; update the record."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-30" name="Recommend a fires task" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-30-desc" body="Propose a fires task with target location and uncertainty, time window, and deconfliction."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-31" name="Manage the decision queue" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-31-desc" body="Order pending decisions by priority and time remaining; apply delegation; escalate; time out."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-32" name="Assist with questions and drafts" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-32-desc" body="Answer questions about the picture and draft products with provenance and no authority."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-33" name="Govern algorithm and model baselines" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-33-desc" body="Validate, promote, and roll back the algorithm and model configuration in force."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-34" name="Authenticate and authorize" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-34-desc" body="Establish who a caller is and what their role permits before any action."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-35" name="Audit" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-35-desc" body="Record every decision, configuration change, promotion, tasking, and assistant exchange append-only."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Activity" xmi:id="OA-36" name="Exchange cooperative identity" visibility="public" isReadOnly="false" isSingleExecution="false">
          <ownedComment xmi:id="OA-36-desc" body="Receive IFF, ADS-B, AIS, and blue-force identity and attach it as evidence."/>
        </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="PKG-If-Sr" name="Information Structure If-Sr">
        <packagedElement xmi:type="uml:Class" xmi:id="IE-01" name="DetectionView" visibility="public">
          <ownedComment xmi:id="IE-01-desc" body="The canonical observation after validation; sensor, source time, receipt time, ENU measurement, provenance."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-02" name="TrackView" visibility="public">
          <ownedComment xmi:id="IE-02-desc" body="The canonical track; state, covariance, classification, provenance, quality, mission time."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-03" name="ResourceView" visibility="public">
          <ownedComment xmi:id="IE-03-desc" body="A taskable resource; position, capacity, readiness."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-04" name="PlanView" visibility="public">
          <ownedComment xmi:id="IE-04-desc" body="The intercept service's recommendation; solutions and policy value."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-05" name="InterceptSolutionView" visibility="public">
          <ownedComment xmi:id="IE-05-desc" body="One resource-to-track pairing with intercept point and time (None until the solver exists)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-06" name="SystemHealth" visibility="public">
          <ownedComment xmi:id="IE-06-desc" body="Tracking, intercept, and ingest health flags as reported, never inferred."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-07" name="Provenance" visibility="public">
          <ownedComment xmi:id="IE-07-desc" body="Source sensors, calibration baseline, algorithm version."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-08" name="Quality" visibility="public">
          <ownedComment xmi:id="IE-08-desc" body="Association confidence, latency, staleness."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-09" name="Classification" visibility="public">
          <ownedComment xmi:id="IE-09-desc" body="Unknown, Neutral, Friendly, Hostile."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-10" name="MissionTime" visibility="public">
          <ownedComment xmi:id="IE-10-desc" body="Seconds on the mission clock."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-11" name="GlobalEntityId" visibility="public">
          <ownedComment xmi:id="IE-11-desc" body="Persistent identity across sessions (u128; uuid v7 under GAP-069)."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-12" name="Envelope" visibility="public">
          <ownedComment xmi:id="IE-12-desc" body="Sequence number, mission time, and one Event; the unit the bus carries and the journal stores."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-13" name="TrackingEvent" visibility="public">
          <ownedComment xmi:id="IE-13-desc" body="TrackInitiated, TrackUpdated, TrackCoasting, TrackDeleted."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-14" name="InterceptEvent" visibility="public">
          <ownedComment xmi:id="IE-14-desc" body="PlanProposed, PlanApproved, PlanSuperseded."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-15" name="IngestEvent" visibility="public">
          <ownedComment xmi:id="IE-15-desc" body="Accepted or Quarantined with reason."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-16" name="CommandEvent" visibility="public">
          <ownedComment xmi:id="IE-16-desc" body="ApprovalRequested; Decided with plan, accepted, operator."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-17" name="ConfigBaseline" visibility="public">
          <ownedComment xmi:id="IE-17-desc" body="Versioned, validated configuration; sensors, resources, tracking, backend, node, horizon, data directory."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-18" name="DecisionRecord" visibility="public">
          <ownedComment xmi:id="IE-18-desc" body="Who decided what on which plan, with verdict and time."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-19" name="PolicyVerdict" visibility="public">
          <ownedComment xmi:id="IE-19-desc" body="Approved (never by built-in engines), Denied with reason, RequiresHumanApproval."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-20" name="AuditEntry" visibility="public">
          <ownedComment xmi:id="IE-20-desc" body="Actor, action, time, outcome; append-only."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-21" name="Alert and AlertLifecycle" visibility="public">
          <ownedComment xmi:id="IE-21-desc" body="Alert with severity; New, Acknowledged, Escalated, Closed with history."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-22" name="SnapshotResponse" visibility="public">
          <ownedComment xmi:id="IE-22-desc" body="Schema version, tracks, plan, health."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-23" name="ApprovalRequest" visibility="public">
          <ownedComment xmi:id="IE-23-desc" body="Plan id, accepted, operator."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-24" name="SubmitDetectionRequest" visibility="public">
          <ownedComment xmi:id="IE-24-desc" body="One DetectionView for the gateway."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-25" name="SubscribeRequest" visibility="public">
          <ownedComment xmi:id="IE-25-desc" body="The first frame of the event stream; from_seq."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-26" name="SchemaEntry" visibility="public">
          <ownedComment xmi:id="IE-26-desc" body="Name, version, kind of a schema the build speaks."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-27" name="SensorRecord and CoverageRegion" visibility="public">
          <ownedComment xmi:id="IE-27-desc" body="Identity, modality, location, calibration version, mode; coverage geometry."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-28" name="Report" visibility="public">
          <ownedComment xmi:id="IE-28-desc" body="A mission report or export with figures traceable to the journal."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-29" name="IdentificationEvidence" visibility="public">
          <ownedComment xmi:id="IE-29-desc" body="One piece of evidence with source and weight toward a classification."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-30" name="RiskScore" visibility="public">
          <ownedComment xmi:id="IE-30-desc" body="Threat score per track with contributing factors."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-31" name="ReconciliationReport" visibility="public">
          <ownedComment xmi:id="IE-31-desc" body="Merged journal statistics and the conflicting decisions found."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-32" name="WorkspaceLayout" visibility="public">
          <ownedComment xmi:id="IE-32-desc" body="The panels a role sees, in order."/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="IE-33" name="Mission and SessionId" visibility="public">
          <ownedComment xmi:id="IE-33-desc" body="A session with its state and configuration."/>
        </packagedElement>
    </packagedElement>
