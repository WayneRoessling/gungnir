@startuml Rs-Cn-tracking-core
title Rs-Cn resource connectivity: Tracking core (from Cargo.toml)
!pragma layout smetana
skinparam componentStyle rectangle
skinparam linetype ortho
left to right direction
package "Tracking core" {
  component "gungnir-allocation" as RS_allocation <<Resource>>
  component "gungnir-association" as RS_association <<Resource>>
  component "gungnir-coord" as RS_coord <<Resource>>
  component "gungnir-core" as RS_core <<Resource>>
  component "gungnir-filters" as RS_filters <<Resource>>
  component "gungnir-fusion-async" as RS_fusion_async <<Resource>>
  component "gungnir-fuzz" as RS_fuzz <<Resource>>
  component "gungnir-metrics" as RS_metrics <<Resource>>
  component "gungnir-oracle" as RS_oracle <<Resource>>
  component "gungnir-rfs" as RS_rfs <<Resource>>
  component "gungnir-scenario" as RS_scenario <<Resource>>
  component "gungnir-testkit" as RS_testkit <<Resource>>
  component "gungnir-track-fusion" as RS_track_fusion <<Resource>>
  component "gungnir-track" as RS_track <<Resource>>
}
component "ingest\n(see Rs-Cn-sense-ingest-normalize)" as RS_ingest <<External>> #line.dashed
component "model\n(see Rs-Cn-foundation-model)" as RS_model <<External>> #line.dashed
RS_allocation --> RS_core
RS_association --> RS_filters
RS_filters --> RS_core
RS_filters --> RS_coord
RS_fusion_async --> RS_track
RS_fusion_async --> RS_rfs
RS_fusion_async --> RS_track_fusion
RS_fusion_async --> RS_core
RS_fusion_async --> RS_filters
RS_fusion_async --> RS_association
RS_fuzz --> RS_association
RS_fuzz --> RS_ingest
RS_fuzz --> RS_model
RS_metrics --> RS_track
RS_metrics --> RS_association
RS_oracle --> RS_filters
RS_oracle --> RS_association
RS_oracle --> RS_rfs
RS_oracle --> RS_scenario
RS_rfs --> RS_track
RS_scenario --> RS_core
RS_scenario --> RS_coord
RS_scenario --> RS_fusion_async
RS_track_fusion --> RS_track
RS_track_fusion --> RS_coord
RS_track --> RS_core
RS_track --> RS_association
@enduml
